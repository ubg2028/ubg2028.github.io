          <input type="text" id="name" required placeholder="Ex: Thomas, 44 ans" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 bg-slate-50/50" />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5" for="message">Votre témoignage</label>
          <textarea id="message" rows="4" required placeholder="Partagez votre ressenti, vos victoires ou vos doutes..." class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 bg-slate-50/50"></textarea>
        </div>
        <button type="submit" class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-brand-500 to-amber-500 hover:from-brand-600 hover:to-amber-600 text-white font-bold text-sm shadow-md hover:shadow-lg transition-all transform active:scale-98">
          Envoyer mon commentaire 💌
        </button>
      </form>
    </section>

  </main>

  <!-- Footer Doux & Zen -->
  <footer class="mt-20 border-t border-orange-100 bg-white/60 py-10 text-center text-xs text-slate-400">
    <div class="max-w-3xl mx-auto px-4 space-y-2">
      <p class="font-semibold text-slate-600">CapQuarantaine • La boussole des hommes qui avancent</p>
      <p>Pensé avec calme, clarté et sérénité. © {new Date().getFullYear()}</p>
    </div>
  </footer>

</body>
