---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Game Not Found — PlayHub">
  <main class="main container" style="text-align:center;padding-top:80px;">
    <h1>404</h1>
    <p style="color:var(--text-muted);">That game doesn't exist or was removed from the catalog.</p>
    <a href="/" class="btn btn-primary" style="display:inline-block;margin-top:12px;">Back to Home</a>
  </main>
</BaseLayout>
