---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = 'My Favorite Games | KawaiiPlay';
const description = 'Your saved favorite games on KawaiiPlay, stored right on this device for quick access anytime.';
---
<BaseLayout title={title} description={description} path="/favorites/">
  <main class="container main-content">
    <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'My Favorites' }]} />
    <h1 style="font-size:clamp(1.4rem,4vw,2rem); font-weight:900; margin-bottom:0.5rem;">💗 My Favorite Games</h1>
    <p style="opacity:0.75; font-weight:600; max-width:680px; margin-bottom:1.5rem;">
      Games you save are stored locally in this browser — tap the 🤍 icon on any game card to add it here.
    </p>
    <p id="favoritesEmpty" class="empty-note">You haven't saved any games yet. Go explore and tap 🤍 on a game you like!</p>
    <div id="favoritesRow" class="chip-row" style="flex-wrap:wrap;"></div>
  </main>
</BaseLayout>
