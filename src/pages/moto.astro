---
// ==========================================
// MOTO X3M UNBLOCKED - ASTRO + TAILWIND CSS
// File: src/pages/moto.astro
// ==========================================

const seo = {
  title: "Moto X3M Unblocked - Play Free Online (Fast & Cute UI)",
  description: "Play Moto X3M Unblocked full screen for free. Enjoy fast, fun bike stunt racing with super cute orange UI and zero lag directly in your browser!",
  canonical: "https://yourwebsite.com/moto",
  gameUrl: "https://motox3m.co/moto-x3m.embed",
  posterImage: "https://images.unsplash.com/photo-1558981806-ec527fa84c39?auto=format&fit=crop&w=1000&q=80"
};

const moreGames = [
  {
    title: "Moto X3M Winter",
    tag: "Winter",
    rating: "4.8",
    category: "❄️ Stunts",
    url: "https://motox3m.co/moto-x3m-winter.embed",
    thumb: "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=400&q=70"
  },
  {
    title: "Moto Pool Party",
    tag: "Summer",
    rating: "4.9",
    category: "🏖️ Racing",
    url: "https://motox3m.co/moto-x3m-pool-party.embed",
    thumb: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=400&q=70"
  },
  {
    title: "Spooky Land",
    tag: "Spooky",
    rating: "4.7",
    category: "🎃 Action",
    url: "https://motox3m.co/moto-x3m-spooky-land.embed",
    thumb: "https://images.unsplash.com/photo-1509198397868-475647b2a1e5?auto=format&fit=crop&w=400&q=70"
  },
  {
    title: "Bike Hero Stunt",
    tag: "Fast",
    rating: "4.8",
    category: "⚡ Nitro",
    url: "https://motox3m.co/moto-x3m.embed",
    thumb: "https://images.unsplash.com/photo-1568772585407-9361f9bf3a87?auto=format&fit=crop&w=400&q=70"
  }
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="keywords" content="moto x3m unblocked, moto x3m game, unblocked games, bike stunts, free online games" />
    <link rel="canonical" href={seo.canonical} />

    <!-- Google Fonts Optimized for CWV -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet" />

    <!-- Tailwind CDN with Custom Cute Theme Config -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                50: '#FFF7F0',
                100: '#FFEAD8',
                200: '#FFD5B2',
                400: '#FF9432',
                500: '#FF7A00', // Cute Primary Orange
                600: '#E66800',
              },
              accent: {
                yellow: '#FFC000',
                dark: '#2D231E',
                muted: '#7A6B63',
              }
            },
            fontFamily: {
              fredoka: ['Fredoka', 'cursive'],
              quicksand: ['Quicksand', 'sans-serif'],
            },
            boxShadow: {
              'cute': '0 10px 25px -5px rgba(255, 122, 0, 0.12), 0 8px 10px -6px rgba(255, 122, 0, 0.08)',
              'cute-hover': '0 20px 30px -10px rgba(255, 122, 0, 0.25)',
              'btn-3d': '0 5px 0px #D86300',
            },
            animation: {
              'cute-pulse': 'cutePulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            },
            keyframes: {
              cutePulse: {
                '0%, 100%': { transform: 'scale(1)' },
                '50%': { transform: 'scale(1.06)' },
              }
            }
          }
        }
      }
    </script>

    <!-- SEO Schema Markup -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "VideoGame",
      "name": "Moto X3M Unblocked",
      "url": seo.canonical,
      "genre": ["Racing", "Stunts", "Action"],
      "playMode": "SinglePlayer",
      "applicationCategory": "Browser Game"
    })} />
  </head>

  <body class="bg-brand-50 text-accent-dark font-quicksand min-h-screen flex flex-col antialiased selection:bg-brand-200 selection:text-brand-600">

    <!-- ================= NAVBAR ================= -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b-2 border-brand-100 shadow-sm">
      <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Logo -->
        <a href="/moto" class="flex items-center gap-2.5 group">
          <div class="w-10 h-10 rounded-2xl bg-brand-500 text-white flex items-center justify-center text-xl shadow-md group-hover:rotate-12 transition-transform">
            🏍️
          </div>
          <span class="font-fredoka text-2xl font-bold text-brand-500 tracking-wide">MotoPlay</span>
        </a>

        <!-- Cute Badge -->
        <div class="bg-brand-100 text-brand-600 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-bold tracking-wide flex items-center gap-1.5 border border-brand-200/50">
          <span>✨</span> <span class="hidden sm:inline">Fast &</span> Cute UI
        </div>
      </nav>
    </header>

    <!-- ================= MAIN CONTENT CONTAINER ================= -->
    <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">

      <!-- HERO HEADING -->
      <div class="text-center mb-5 sm:mb-6">
        <h1 class="font-fredoka text-2xl sm:text-3xl md:text-4xl text-brand-500 font-bold inline-flex items-center justify-center gap-2 flex-wrap">
          Moto X3M Unblocked
          <span class="bg-accent-yellow text-amber-950 text-xs sm:text-sm px-2.5 py-1 rounded-full uppercase tracking-wider font-bold shadow-sm">
            HOT 🔥
          </span>
        </h1>
      </div>

      <!-- ================= GAME CONTAINER (0 CLS: aspect-video) ================= -->
      <div id="gameContainer" class="relative w-full aspect-video bg-neutral-900 rounded-2xl sm:rounded-3xl overflow-hidden shadow-cute border-4 border-white">
        
        <!-- Lazy Poster Overlay -->
        <div 
          id="gamePoster" 
          class="absolute inset-0 z-10 bg-cover bg-center flex items-center justify-center cursor-pointer transition-opacity duration-300"
          style={`background-image: linear-gradient(rgba(0,0,0,0.25), rgba(0,0,0,0.65)), url('${seo.posterImage}')`}
        >
          <button id="playBtn" class="animate-cute-pulse bg-gradient-to-b from-brand-400 to-brand-500 hover:from-brand-500 hover:to-brand-600 text-white font-fredoka font-bold text-lg sm:text-2xl px-6 sm:px-10 py-3 sm:py-4 rounded-full shadow-btn-3d flex items-center gap-3 border-2 border-white/40 active:translate-y-1 transition-all" aria-label="Play Moto X3M Now">
            <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
            PLAY NOW
          </button>
        </div>

        <!-- Deferred Iframe -->
        <iframe 
          id="gameIframe" 
          class="w-full h-full border-0 hidden"
          data-src={seo.gameUrl}
          title="Moto X3M Unblocked Game" 
          allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen>
        </iframe>
      </div>

      <!-- ================= GAME CONTROL BAR ================= -->
      <div class="mt-3 sm:mt-4 bg-white rounded-xl sm:rounded-2xl p-3 sm:p-4 shadow-cute flex items-center justify-between gap-2 border border-brand-100">
        <div class="flex items-center gap-2">
          <span class="text-accent-yellow text-sm sm:text-base">★★★★★</span>
          <span class="text-xs sm:text-sm font-bold text-accent-muted">4.9 / 5</span>
        </div>

        <div class="flex items-center gap-2 sm:gap-3">
          <button id="fsBtn" class="bg-brand-100 hover:bg-brand-500 text-brand-600 hover:text-white font-fredoka font-semibold px-3 sm:px-4 py-2 rounded-xl text-xs sm:text-sm flex items-center gap-1.5 transition-all active:translate-y-0.5" aria-label="Fullscreen">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
            </svg>
            <span>Fullscreen</span>
          </button>

          <button id="reloadBtn" class="bg-brand-100 hover:bg-brand-500 text-brand-600 hover:text-white font-fredoka font-semibold px-3 sm:px-4 py-2 rounded-xl text-xs sm:text-sm flex items-center gap-1.5 transition-all active:translate-y-0.5" aria-label="Restart">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
            </svg>
            <span class="hidden sm:inline">Restart</span>
          </button>
        </div>
      </div>

      <!-- ================= SEO DESCRIPTION ================= -->
      <article class="mt-8 bg-white rounded-2xl p-5 sm:p-7 shadow-cute border-l-4 border-brand-500">
        <h2 class="font-fredoka text-xl sm:text-2xl text-brand-500 font-bold mb-2">
          About Moto X3M Unblocked
        </h2>
        <p class="text-accent-dark/80 text-sm sm:text-base leading-relaxed">
          Welcome to <strong>Moto X3M Unblocked</strong>! Put on your racing helmet, grip the handlebars, and speed through challenging obstacle tracks packed with massive loops, deadly spikes, and explosive TNT traps. Perform insane flips in the air to save precious seconds and achieve 3 stars on every level!
        </p>
      </article>

      <!-- ================= MORE GAMES RESPONSIVE GRID ================= -->
      <section class="mt-10 sm:mt-12">
        <div class="flex items-center gap-2 mb-5">
          <span class="text-2xl">🎮</span>
          <h2 class="font-fredoka text-2xl sm:text-3xl font-bold text-accent-dark">More Awesome Games</h2>
        </div>

        <!-- Fully Responsive: 2 cols on mobile, 3 on tablet, 4 on desktop -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3.5 sm:gap-5">
          {moreGames.map((game) => (
            <div 
              class="game-card group bg-white rounded-2xl overflow-hidden shadow-cute hover:shadow-cute-hover transition-all duration-300 hover:-translate-y-1.5 cursor-pointer border border-transparent hover:border-brand-200 flex flex-col"
              data-url={game.url}
            >
              <div class="relative aspect-[4/3] overflow-hidden bg-neutral-100">
                <span class="absolute top-2 right-2 z-10 bg-black/60 backdrop-blur-sm text-white text-[10px] font-bold px-2 py-0.5 rounded-full">
                  {game.tag}
                </span>
                <img 
                  src={game.thumb} 
                  alt={game.title} 
                  loading="lazy" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
                />
              </div>
              <div class="p-3 sm:p-3.5 flex flex-col justify-between flex-1">
                <h3 class="font-fredoka text-sm sm:text-base font-bold text-accent-dark truncate group-hover:text-brand-500 transition-colors">
                  {game.title}
                </h3>
                <div class="flex items-center justify-between text-xs text-accent-muted font-bold mt-2">
                  <span>{game.category}</span>
                  <span class="text-amber-500">⭐ {game.rating}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="mt-12 bg-white border-t-2 border-brand-100 py-6 text-center text-xs sm:text-sm text-accent-muted">
      <div class="max-w-6xl mx-auto px-4">
        <p>© 2025 MotoPlay - Fast, Cute & Safe Gaming Playground.</p>
      </div>
    </footer>

    <!-- ================= CLIENT JAVASCRIPT ================= -->
    <script>
      const iframe = document.getElementById('gameIframe') as HTMLIFrameElement;
      const poster = document.getElementById('gamePoster') as HTMLElement;
      const container = document.getElementById('gameContainer') as HTMLElement;
      const playBtn = document.getElementById('playBtn') as HTMLButtonElement;
      const fsBtn = document.getElementById('fsBtn') as HTMLButtonElement;
      const reloadBtn = document.getElementById('reloadBtn') as HTMLButtonElement;
      const gameCards = document.querySelectorAll('.game-card');

      function loadGame(customUrl?: string) {
        poster.style.display = 'none';
        iframe.classList.remove('hidden');
        const targetUrl = customUrl || iframe.getAttribute('data-src');
        if (targetUrl && iframe.src !== targetUrl) {
          iframe.src = targetUrl;
        }
      }

      playBtn?.addEventListener('click', () => loadGame());
      poster?.addEventListener('click', () => loadGame());

      // Fullscreen
      fsBtn?.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          container.requestFullscreen?.();
        } else {
          document.exitFullscreen?.();
        }
      });

      // Reload Game
      reloadBtn?.addEventListener('click', () => {
        if (iframe.src) {
          const current = iframe.src;
          iframe.src = '';
          iframe.src = current;
        }
      });

      // Switch Games on click from More Games grid
      gameCards.forEach(card => {
        card.addEventListener('click', () => {
          const url = card.getAttribute('data-url');
          if (url) {
            loadGame(url);
            window.scrollTo({ top: container.offsetTop - 80, behavior: 'smooth' });
          }
        });
      });
    </script>
  </body>
</html>
