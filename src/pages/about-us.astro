---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'About Us | KawaiiPlay';
const description = 'Learn about KawaiiPlay — a free browser gaming site for cute, fun, and fast arcade, puzzle, and casual games.';
---
<BaseLayout title={title} description={description} path="/about-us/">
  <main class="container">
    <article class="content-page">
      <h1>About KawaiiPlay</h1>
      <p class="updated-note">Making browser gaming cute, fast, and free.</p>

      <p>KawaiiPlay is a free online games portal focused on cute, colorful, and instantly playable browser games. No downloads, no installs, no sign-ups — just pick a game and hit "PLAY NOW".</p>

      <h2>What We Offer</h2>
      <ul>
        <li>A growing library of arcade, puzzle, racing, dress-up, and casual games, organized by category.</li>
        <li>A fast, mobile-friendly site that works directly in your browser.</li>
        <li>Handy features like Favorites and Recently Played so you can jump back into the games you love.</li>
      </ul>

      <h2>Our Mission</h2>
      <p>We built KawaiiPlay because we love quick, low-pressure games you can enjoy on a coffee break, between classes, or while unwinding at home. Our goal is to keep the library fresh, the site fast, and the experience genuinely fun.</p>

      <h2>Get In Touch</h2>
      <p>Have a suggestion, found a bug, or want to partner with us? Visit our <a href="/contact-us/">Contact Us</a> page — we'd love to hear from you.</p>
    </article>
  </main>
</BaseLayout>
