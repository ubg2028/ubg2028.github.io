---
// Generational Career Clarity - Single File Cute & Professional Astro Page
const title = "The Generational Career Trap | Neil Patel Style Masterclass";
const readingTime = "8 min read";
const publishDate = "Updated Today";
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  
  <!-- Fonts: Plus Jakarta Sans for a fresh, cute, clean modern look -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS via CDN for instant single-file zero-setup rendering -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
          },
          colors: {
            cream: '#FCFAF7',
            coral: { 50: '#FFF5F2', 100: '#FFE8E2', 400: '#FF8A65', 500: '#FF6B4A', 600: '#E85333' },
            mint: { 50: '#F0FDF8', 100: '#DCFCE7', 500: '#10B981', 600: '#059669' },
            bubble: { 50: '#F5F3FF', 100: '#EDE9FE', 500: '#8B5CF6' },
            sun: { 50: '#FFFBEB', 100: '#FEF3C7', 400: '#FBBF24', 500: '#F59E0B' }
          },
          boxShadow: {
            'cute': '0 10px 30px -5px rgba(255, 107, 74, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04)',
            'card': '0 14px 34px rgba(20, 20, 43, 0.04)',
            'float': '0 20px 40px -15px rgba(0, 0, 0, 0.07)'
          }
        }
      }
    }
  </script>
  <style>
    /* Custom Cute Scrollbar & Details summary marker removal */
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #FCFAF7; }
    ::-webkit-scrollbar-thumb { background: #FFD4C9; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #FF8A65; }
    details > summary::-webkit-details-marker { display: none; }
  </style>
</head>

<body class="bg-cream text-slate-800 font-sans antialiased selection:bg-coral-100 selection:text-coral-600">

  <!-- Sticky Top Reading Progress Bar -->
  <div class="fixed top-0 left-0 w-full h-1.5 bg-coral-100 z-50">
    <div id="progress-bar" class="h-full bg-coral-500 rounded-r-full transition-all duration-150 w-0"></div>
  </div>

  <!-- Cute Floating Nav Header -->
  <header class="sticky top-4 z-40 max-w-4xl mx-auto px-4">
    <div class="bg-white/80 backdrop-blur-md border border-slate-150/70 shadow-cute rounded-full px-5 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <span class="w-9 h-9 rounded-2xl bg-coral-500 flex items-center justify-center text-white text-lg shadow-sm">🎯</span>
        <div>
          <span class="font-extrabold text-sm tracking-tight text-slate-900 block leading-tight">CareerClarity<span class="text-coral-500">.io</span></span>
          <span class="text-[10px] font-semibold text-slate-500 block uppercase tracking-wider">Generational Playbook</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <span class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 bg-mint-50 text-mint-600 text-xs font-bold rounded-full border border-mint-100">
          <span class="w-2 h-2 rounded-full bg-mint-500 animate-pulse"></span> {readingTime}
        </span>
        <a href="#audit-section" class="px-4 py-2 bg-slate-900 hover:bg-coral-500 text-white text-xs font-bold rounded-full transition-all shadow-sm hover:shadow-coral-500/25 active:scale-95">
          Run Career Audit ✨
        </a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <main class="max-w-4xl mx-auto px-4 pt-12 pb-24">
    
    <div class="text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-coral-50 border border-coral-100 text-coral-600 text-xs font-bold rounded-full shadow-xs">
        <span>✨ Stop Running The Zero-Reset Race</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
        The Generational Career Trap: <br class="hidden sm:block"/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-coral-500 via-bubble-500 to-coral-600">
          Why Prestigious Jobs Reset You to Zero
        </span>
      </h1>

      <p class="max-w-2xl mx-auto text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
        Most families spend 40 minutes buying a smartphone, but zero days planning a 40-year generational career. Let's fix that right now.
      </p>

      <!-- Author Tag (Neil Patel Inspired) -->
      <div class="pt-2 flex items-center justify-center gap-3 text-xs text-slate-500 font-medium">
        <div class="flex items-center gap-2 bg-white px-3.5 py-1.5 rounded-full border border-slate-100 shadow-xs">
          <span class="w-6 h-6 rounded-full bg-gradient-to-tr from-coral-400 to-bubble-500 text-white flex items-center justify-center font-bold text-[10px]">NP</span>
          <span>By <strong>Career Architect</strong></span>
          <span>•</span>
          <span class="text-slate-400">{publishDate}</span>
        </div>
      </div>
    </div>

    <!-- Cute Quick Hook Card -->
    <section class="mt-10 bg-gradient-to-br from-white to-coral-50/40 border border-coral-100/80 rounded-3xl p-6 sm:p-8 shadow-cute relative overflow-hidden">
      <div class="absolute -right-6 -bottom-6 w-32 h-32 bg-coral-100/50 rounded-full blur-2xl pointer-events-none"></div>
      
      <p class="text-sm font-bold uppercase tracking-wider text-coral-500 mb-2">Here's The Brutal Truth 👇</p>
      <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 mb-4">
        Not all prestigious jobs create generational wealth.
      </h2>
      <p class="text-slate-700 leading-relaxed mb-4">
        You will spend <strong>40 years</strong> of your life working. If your position automatically takes away your rank, client book, and authority the day you retire, <strong>your children are forced to start at ground zero</strong>.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
        <div class="flex items-start gap-2.5 p-3 rounded-2xl bg-white border border-slate-150">
          <span class="text-lg">🛑</span>
          <p class="text-xs text-slate-600 leading-normal"><strong>Linear Jobs:</strong> 40 years of service = high status, but zero inheritable systems.</p>
        </div>
        <div class="flex items-start gap-2.5 p-3 rounded-2xl bg-white border border-slate-150">
          <span class="text-lg">🚀</span>
          <p class="text-xs text-slate-600 leading-normal"><strong>Compounding Jobs:</strong> 40 years of service = transferable equity, clients & leverage.</p>
        </div>
      </div>
    </section>

    <!-- Historical Story: 1571 Mansabdari System -->
    <section class="mt-14">
      <div class="flex items-center gap-2 mb-3">
        <span class="px-2.5 py-1 rounded-lg bg-sun-100 text-sun-500 text-xs font-black">HISTORICAL ORIGIN</span>
        <span class="text-xs font-semibold text-slate-400">1571 A.D.</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-4">
        The 1571 Mansabdari Trap: History's Smartest Illusion 📜
      </h2>

      <p class="text-slate-700 leading-relaxed mb-4">
        In 1571, Mughal Emperor Akbar introduced an administrative marvel: the <strong>Mansabdari System</strong>. On paper, it was the ultimate dream career. You commanded 1,000 to 5,000 troops, drew a lavish salary of roughly 3,000 rupees a month, and lived like royalty.
      </p>

      <!-- The Catch Infographic Card -->
      <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-card my-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
          <span class="font-bold text-slate-800 text-sm">How The Mansabdari Cycle Actually Worked:</span>
          <span class="text-xs font-extrabold px-2.5 py-1 bg-red-50 text-red-500 rounded-full">Zero Inheritance</span>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 relative">
          <div class="p-3.5 bg-slate-50 rounded-2xl text-center space-y-1">
            <div class="w-8 h-8 rounded-full bg-coral-100 text-coral-600 font-extrabold text-xs flex items-center justify-center mx-auto">1</div>
            <p class="text-xs font-bold text-slate-800">Assigned Rank</p>
            <p class="text-[11px] text-slate-500">Given troops, horses, and tax collection power.</p>
          </div>
          <div class="p-3.5 bg-slate-50 rounded-2xl text-center space-y-1">
            <div class="w-8 h-8 rounded-full bg-coral-100 text-coral-600 font-extrabold text-xs flex items-center justify-center mx-auto">2</div>
            <p class="text-xs font-bold text-slate-800">Lavish Life</p>
            <p class="text-[11px] text-slate-500">Draws salary, maintains status and high lifestyle.</p>
          </div>
          <div class="p-3.5 bg-slate-50 rounded-2xl text-center space-y-1">
            <div class="w-8 h-8 rounded-full bg-red-100 text-red-600 font-extrabold text-xs flex items-center justify-center mx-auto">3</div>
            <p class="text-xs font-bold text-slate-800">Retirement/Death</p>
            <p class="text-[11px] text-slate-500">The state seizes back all troops, ranks & jagirs.</p>
          </div>
          <div class="p-3.5 bg-slate-50 rounded-2xl text-center space-y-1">
            <div class="w-8 h-8 rounded-full bg-red-100 text-red-600 font-extrabold text-xs flex items-center justify-center mx-auto">4</div>
            <p class="text-xs font-bold text-slate-800">Child at Point 0</p>
            <p class="text-[11px] text-slate-500">The child must restart from the very lowest step.</p>
          </div>
        </div>
      </div>

      <p class="text-slate-700 leading-relaxed">
        <strong>The catch?</strong> The Mansab was strictly <em>non-inheritable</em>. The moment a Mansabdar died or retired, his hard-earned command vanished. His 40 years of sweat built the Emperor's empire, but <strong>zero equity</strong> for his own bloodline.
      </p>
    </section>

    <!-- Modern Equivalent Section -->
    <section class="mt-14">
      <div class="flex items-center gap-2 mb-3">
        <span class="px-2.5 py-1 rounded-lg bg-coral-100 text-coral-600 text-xs font-black">REALITY CHECK</span>
        <span class="text-xs font-semibold text-slate-400">Present Day</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-4">
        Who Are Today's Mansabdars? 🎖️
      </h2>
      <p class="text-slate-700 leading-relaxed mb-6">
        Civil bureaucrats, administrative heads, and uniformed defense forces (IAS, IPS, CRPF, BSF, Police). 
        You reach the very top. You make decisions for millions. You have bungalows and convoys. 
      </p>

      <div class="bg-coral-50 border border-coral-200/60 rounded-3xl p-6">
        <p class="text-sm font-bold text-coral-600 mb-2">💡 The Day You Turn 60:</p>
        <p class="text-slate-700 text-sm leading-relaxed mb-3">
          You surrender the official vehicle. You vacate the bungalow. All that remains is an emotional trophy: <em>"Retired Director General"</em> or <em>"Ex-Chief Engineer"</em>.
        </p>
        <div class="p-4 bg-white rounded-2xl border border-coral-150">
          <p class="text-xs text-slate-700 leading-relaxed">
            <strong>And your child?</strong> They cannot inherit one percent of your administrative clout. If they want to enter that same service, they must sit in the same scorching exam hall alongside 1,000,000 candidates and start at ground zero.
          </p>
        </div>
      </div>
    </section>

    <!-- Bucket Comparison Table -->
    <section class="mt-16">
      <div class="text-center max-w-lg mx-auto mb-8">
        <span class="px-3 py-1 bg-bubble-100 text-bubble-500 font-extrabold text-xs rounded-full uppercase tracking-wider">The Strategic Choice</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">Which Bucket Are You In?</h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Both can feed your family, but only one gives your kids an unfair advantage.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        
        <!-- Bucket 1 Card -->
        <div class="bg-white border-2 border-slate-100 rounded-3xl p-6 shadow-card hover:border-slate-300 transition-all">
          <div class="flex items-center justify-between mb-4">
            <span class="text-2xl">🏛️</span>
            <span class="text-[11px] font-extrabold uppercase tracking-wide bg-slate-100 text-slate-600 px-3 py-1 rounded-full">Bucket A</span>
          </div>
          <h3 class="text-lg font-extrabold text-slate-900 mb-1">The Modern Mansabdar</h3>
          <p class="text-xs text-slate-500 mb-4">Civil Bureaucracy, Defense, Linear Govt Jobs</p>

          <ul class="space-y-3 text-xs text-slate-600 border-t border-slate-100 pt-4">
            <li class="flex items-start gap-2">
              <span class="text-red-500 font-bold">✕</span>
              <span><strong>Asset Transferability:</strong> Zero. Power stays with the chair.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-red-500 font-bold">✕</span>
              <span><strong>10-Year Overlap:</strong> Zero. You cannot co-sign files with your child.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-red-500 font-bold">✕</span>
              <span><strong>Geographic Roots:</strong> Weakened by mandatory transfers every 3 years.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-mint-500 font-bold">✓</span>
              <span><strong>Day-1 Prestige:</strong> Instant social respect and job safety.</span>
            </li>
          </ul>
        </div>

        <!-- Bucket 2 Card -->
        <div class="bg-gradient-to-b from-white to-mint-50/30 border-2 border-mint-500/40 rounded-3xl p-6 shadow-cute relative overflow-hidden">
          <div class="absolute top-0 right-0 bg-mint-500 text-white text-[10px] font-black uppercase tracking-wider px-3 py-1 rounded-bl-xl">Recommended</div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-2xl">🌱</span>
            <span class="text-[11px] font-extrabold uppercase tracking-wide bg-mint-100 text-mint-600 px-3 py-1 rounded-full">Bucket B</span>
          </div>
          <h3 class="text-lg font-extrabold text-slate-900 mb-1">The Compounding Architect</h3>
          <p class="text-xs text-slate-500 mb-4">Law, Medicine/Clinics, CA, Architecture & Design</p>

          <ul class="space-y-3 text-xs text-slate-700 border-t border-mint-100 pt-4">
            <li class="flex items-start gap-2">
              <span class="text-mint-500 font-bold">✓</span>
              <span><strong>Asset Transferability:</strong> 100%. Clients, leases & reputation transfer.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-mint-500 font-bold">✓</span>
              <span><strong>10-Year Overlap:</strong> Seamless transition & mentorship period.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-mint-500 font-bold">✓</span>
              <span><strong>Geographic Roots:</strong> Deep compounding local influence & commercial assets.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-mint-500 font-bold">✓</span>
              <span><strong>Child's Baseline:</strong> Kid starts from Step 100, not Step Zero.</span>
            </li>
          </ul>
        </div>

      </div>
    </section>

    <!-- The All-India Migration Treadmill -->
    <section class="mt-16 bg-white border border-slate-100 rounded-3xl p-6 sm:p-8 shadow-card">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-xl">🧳</span>
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900">The All-India Migration Treadmill</h2>
      </div>
      <p class="text-sm text-slate-600 leading-relaxed mb-6">
        Does this sound like your family? Look at the three-generation trap:
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center">
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
          <p class="text-xs font-extrabold text-coral-500 mb-1">Generation 1 (Dada ji)</p>
          <p class="text-xs font-semibold text-slate-700">Moved 12 Times</p>
          <p class="text-[11px] text-slate-500 mt-1">Built zero rooted enterprise; constantly changing cities.</p>
        </div>
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
          <p class="text-xs font-extrabold text-coral-500 mb-1">Generation 2 (Pitaji)</p>
          <p class="text-xs font-semibold text-slate-700">Moved 8 Times</p>
          <p class="text-[11px] text-slate-500 mt-1">Rented quarters, distant plots, scattered relations.</p>
        </div>
        <div class="p-4 rounded-2xl bg-coral-50 border border-coral-200">
          <p class="text-xs font-extrabold text-coral-600 mb-1">Generation 3 (You)</p>
          <p class="text-xs font-semibold text-slate-900">Packing Bags Again?</p>
          <p class="text-[11px] text-slate-600 mt-1">If all 3 generations move constantly, who actually compounds?</p>
        </div>
      </div>

      <div class="mt-5 p-4 bg-sun-50 rounded-2xl border border-sun-100 text-xs text-slate-700 leading-relaxed">
        <strong>The Deep Roots Factor:</strong> Staying anchored in one high-growth economic center allows local trust, business ties, legal rapport, and commercial real estate to multiply over 30 years.
      </div>
    </section>

    <!-- The Passion Trap -->
    <section class="mt-14">
      <div class="bg-gradient-to-br from-bubble-50 to-white border border-bubble-100 rounded-3xl p-6 sm:p-8">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-xl">🎨</span>
          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900">The "Follow Your Passion" Myth</h2>
        </div>
        <p class="text-sm text-slate-700 leading-relaxed mb-4">
          Passion is just a temporary feeling. And feelings change every 3 years.
        </p>

        <div class="bg-white rounded-2xl p-4 border border-bubble-100 shadow-xs mb-4">
          <p class="text-xs text-slate-600 leading-relaxed">
            <strong>The Classic Spiral:</strong> A student studies <em>Biotechnology</em> → loses interest by Year 3 → finishes the degree under stress → pivots to <em>3D Animation</em> → entry wages are low → panics at age 26 and starts preparing for generic competitive exams.
          </p>
        </div>

        <p class="text-xs font-medium text-slate-500">
          ✨ <strong>Pro Tip:</strong> Competence builds passion far faster than passion builds competence. Choose a field where skills compound into transferable equity.
        </p>
      </div>
    </section>

    <!-- The 15-Year Handover Playbook (Step-by-Step) -->
    <section class="mt-16">
      <div class="text-center max-w-lg mx-auto mb-10">
        <span class="px-3 py-1 bg-coral-100 text-coral-600 font-extrabold text-xs rounded-full uppercase tracking-wider">Implementation Guide</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">The 15-Year Handover Roadmap</h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">How independent professionals transition empires without friction.</p>
      </div>

      <div class="space-y-4">
        
        <!-- Step 1 -->
        <div class="flex flex-col sm:flex-row items-start gap-4 p-5 bg-white border border-slate-100 rounded-3xl shadow-card">
          <div class="w-10 h-10 rounded-2xl bg-coral-500 text-white font-black text-sm flex items-center justify-center shrink-0 shadow-sm">
            01
          </div>
          <div>
            <h3 class="text-base font-extrabold text-slate-900">Years 1–3: The External Shadowing Phase</h3>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed">
              The child earns professional qualifications and works at an external, third-party firm first. This instills work ethics, punctuality, and eliminates entitlement before stepping into the family firm.
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="flex flex-col sm:flex-row items-start gap-4 p-5 bg-white border border-slate-100 rounded-3xl shadow-card">
          <div class="w-10 h-10 rounded-2xl bg-bubble-500 text-white font-black text-sm flex items-center justify-center shrink-0 shadow-sm">
            02
          </div>
          <div>
            <h3 class="text-base font-extrabold text-slate-900">Years 4–8: Integration & Ground Execution</h3>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed">
              The child enters the family practice. They handle smaller briefs, operational hurdles, and sit beside the parent in key client meetings, absorbing unwritten soft-negotiation skills.
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="flex flex-col sm:flex-row items-start gap-4 p-5 bg-white border border-slate-100 rounded-3xl shadow-card">
          <div class="w-10 h-10 rounded-2xl bg-mint-500 text-white font-black text-sm flex items-center justify-center shrink-0 shadow-sm">
            03
          </div>
          <div>
            <h3 class="text-base font-extrabold text-slate-900">Years 9–12: Primary Client Transfer</h3>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed">
              The parent steps back from daily firefighting. Key accounts and regular clients now interact primarily with the child, while the parent maintains senior strategic oversight.
            </p>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="flex flex-col sm:flex-row items-start gap-4 p-5 bg-white border border-slate-100 rounded-3xl shadow-card">
          <div class="w-10 h-10 rounded-2xl bg-slate-900 text-white font-black text-sm flex items-center justify-center shrink-0 shadow-sm">
            04
          </div>
          <div>
            <h3 class="text-base font-extrabold text-slate-900">Years 13–15: Complete Operational Command</h3>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed">
              The firm operates under full next-gen leadership. Goodwill, cash flow, physical premises, and client trust remain completely intact without starting from scratch.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- Interactive Self-Audit Card -->
    <section id="audit-section" class="mt-16 bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-3xl p-6 sm:p-10 shadow-float">
      <div class="flex items-center gap-2 mb-2 text-coral-400 font-extrabold text-xs uppercase tracking-wider">
        <span>⚡ Quick Interactive Check</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-2">
        Is Your Family Career Building Real Equity?
      </h2>
      <p class="text-xs sm:text-sm text-slate-300 mb-6">
        Check all statements that apply to your current professional trajectory:
      </p>

      <div class="space-y-3" id="audit-checklist">
        <label class="flex items-center gap-3 p-3.5 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 cursor-pointer transition-all">
          <input type="checkbox" class="audit-check w-4 h-4 rounded accent-coral-500 cursor-pointer" />
          <span class="text-xs text-slate-200">My clients or professional goodwill can be directly transferred to my child.</span>
        </label>
        <label class="flex items-center gap-3 p-3.5 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 cursor-pointer transition-all">
          <input type="checkbox" class="audit-check w-4 h-4 rounded accent-coral-500 cursor-pointer" />
          <span class="text-xs text-slate-200">Our family is rooted in one primary economic center, building multi-decade ties.</span>
        </label>
        <label class="flex items-center gap-3 p-3.5 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 cursor-pointer transition-all">
          <input type="checkbox" class="audit-check w-4 h-4 rounded accent-coral-500 cursor-pointer" />
          <span class="text-xs text-slate-200">My child can legally and practically shadow me at work during their 20s.</span>
        </label>
        <label class="flex items-center gap-3 p-3.5 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 cursor-pointer transition-all">
          <input type="checkbox" class="audit-check w-4 h-4 rounded accent-coral-500 cursor-pointer" />
          <span class="text-xs text-slate-200">Retirement does not cancel my official authority or strip away my primary assets.</span>
        </label>
      </div>

      <div class="mt-6 pt-5 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div id="audit-result" class="text-xs font-bold text-coral-400">
          Select the items above to see your score!
        </div>
        <button onclick="calculateAudit()" class="px-5 py-2.5 bg-coral-500 hover:bg-coral-600 text-white font-extrabold text-xs rounded-full transition-all active:scale-95 shadow-lg shadow-coral-500/30">
          Evaluate My Architecture
        </button>
      </div>
    </section>

    <!-- FAQ Section (Cute Accordion) -->
    <section class="mt-16">
      <div class="text-center max-w-lg mx-auto mb-8">
        <span class="px-3 py-1 bg-sun-100 text-sun-500 font-extrabold text-xs rounded-full uppercase tracking-wider">Got Questions?</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">Frequently Asked Questions</h2>
      </div>

      <div class="space-y-3">
        
        <details class="group bg-white border border-slate-150 rounded-2xl p-4 open:shadow-card transition-all">
          <summary class="flex justify-between items-center font-bold text-sm text-slate-800 cursor-pointer">
            <span>Are you saying government jobs have zero value?</span>
            <span class="text-coral-500 group-open:rotate-180 transition-transform font-black">↓</span>
          </summary>
          <div class="text-xs text-slate-600 mt-3 pt-3 border-t border-slate-100 leading-relaxed">
            Not at all. For lower-income or first-generation families, a government job provides an invaluable safety net. However, for <strong>upper-middle-class families</strong> who already have financial security, re-entering a 4-year exam cycle for a non-transferable seat resets generational compounding.
          </div>
        </details>

        <details class="group bg-white border border-slate-150 rounded-2xl p-4 open:shadow-card transition-all">
          <summary class="flex justify-between items-center font-bold text-sm text-slate-800 cursor-pointer">
            <span>What if my child doesn't want to join my practice?</span>
            <span class="text-coral-500 group-open:rotate-180 transition-transform font-black">↓</span>
          </summary>
          <div class="text-xs text-slate-600 mt-3 pt-3 border-t border-slate-100 leading-relaxed">
            Never force your child into a field they genuinely dislike. However, ensure they understand the difference between linear and compounding paths. If they choose another path, guide them toward building their own transferable enterprise rather than a linear reset job.
          </div>
        </details>

        <details class="group bg-white border border-slate-150 rounded-2xl p-4 open:shadow-card transition-all">
          <summary class="flex justify-between items-center font-bold text-sm text-slate-800 cursor-pointer">
            <span>Why is geographic stability so important in the modern era?</span>
            <span class="text-coral-500 group-open:rotate-180 transition-transform font-black">↓</span>
          </summary>
          <div class="text-xs text-slate-600 mt-3 pt-3 border-t border-slate-100 leading-relaxed">
            When you relocate every few years, your network stays superficial. Staying anchored in one city allows institutional friendships, client goodwill, and commercial properties to compound in value over decades.
          </div>
        </details>

      </div>
    </section>

    <!-- Neil Patel Style Comment Driving Box / Call To Action -->
    <section class="mt-16 bg-gradient-to-tr from-coral-50 via-white to-sun-50 border-2 border-coral-200/80 rounded-3xl p-6 sm:p-10 shadow-cute text-center">
      <span class="w-12 h-12 rounded-full bg-coral-500 text-white text-2xl flex items-center justify-center mx-auto mb-3 shadow-md">
        💬
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        What Bucket Are You Currently In?
      </h2>
      <p class="text-slate-600 text-sm max-w-md mx-auto mt-2 leading-relaxed">
        Are you on the <strong>Mansabdari treadmill</strong>, or are you building <strong>transferable equity</strong> for your kids? Drop your take below.
      </p>

      <!-- Interactive Mini Reaction Bar -->
      <div class="flex items-center justify-center gap-3 my-6">
        <button onclick="react('mansab')" class="px-4 py-2 bg-white border border-slate-200 hover:border-coral-400 rounded-full text-xs font-bold text-slate-700 transition-all shadow-xs flex items-center gap-1.5 active:scale-95">
          🏛️ In Bucket A (<span id="count-mansab">248</span>)
        </button>
        <button onclick="react('architect')" class="px-4 py-2 bg-white border border-slate-200 hover:border-mint-400 rounded-full text-xs font-bold text-slate-700 transition-all shadow-xs flex items-center gap-1.5 active:scale-95">
          🌱 In Bucket B (<span id="count-architect">412</span>)
        </button>
      </div>

      <!-- Comment Box Placeholder -->
      <div class="max-w-md mx-auto space-y-3">
        <textarea 
          placeholder="Share your perspective... (I read and reply to every thoughtful comment!)" 
          rows="3" 
          class="w-full text-xs p-3.5 rounded-2xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-coral-400 bg-white"
        ></textarea>
        <button onclick="submitComment()" class="w-full py-3 bg-coral-500 hover:bg-coral-600 text-white font-extrabold text-xs rounded-2xl transition-all shadow-md shadow-coral-500/25 active:scale-98">
          Post Comment & Join The Discussion ✨
        </button>
        <p id="comment-msg" class="text-[11px] font-bold text-mint-600 hidden">Thanks for sharing! Your comment is under review.</p>
      </div>
    </section>

  </main>

  <!-- Cute Footer -->
  <footer class="border-t border-slate-200/60 bg-white/50 py-8 text-center text-xs text-slate-400">
    <p>© 2025 CareerClarity.io • Built with ❤️ using Astro & Tailwind</p>
    <p class="mt-1">Think 40 years ahead, not just 40 days.</p>
  </footer>

  <!-- Vanilla Micro-Interactivity Script -->
  <script is:inline>
    // 1. Scroll Progress Bar
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      document.getElementById('progress-bar').style.width = scrolled + '%';
    });

    // 2. Audit Calculator
    function calculateAudit() {
      const checks = document.querySelectorAll('.audit-check:checked');
      const resultBox = document.getElementById('audit-result');
      const count = checks.length;

      if (count === 4) {
        resultBox.textContent = "🚀 100% Compounding Dynasty! Your kids have a huge launchpad.";
        resultBox.className = "text-xs font-extrabold text-mint-400";
      } else if (count >= 2) {
        resultBox.textContent = "⚖️ Balanced/In-Transition. Start anchoring your core assets!";
        resultBox.className = "text-xs font-extrabold text-sun-400";
      } else {
        resultBox.textContent = "⚠️ Linear Mansabdari Trap Detected! You need a 15-year equity plan.";
        resultBox.className = "text-xs font-extrabold text-coral-400";
      }
    }

    // 3. Mini Reaction Counters
    function react(type) {
      const el = document.getElementById('count-' + type);
      el.textContent = parseInt(el.textContent) + 1;
    }

    // 4. Comment Submission Simulation
    function submitComment() {
      const msg = document.getElementById('comment-msg');
      msg.classList.remove('hidden');
      setTimeout(() => {
        msg.classList.add('hidden');
      }, 4000);
    }
  </script>

</body>
</html>
