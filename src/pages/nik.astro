---
// Generational Career Clarity - 100% Standalone Cute UI (Zero Config Required)
const title = "The Generational Career Trap | Neil Patel Style Masterclass";
const readingTime = "8 min read";
const publishDate = "Updated Today";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  
  <!-- Google Font: Plus Jakarta Sans for cute modern look -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style is:global>
    :root {
      --bg-cream: #FAF8F5;
      --card-bg: #FFFFFF;
      --text-main: #1E293B;
      --text-muted: #64748B;
      
      /* Cute Pastel Color Palette */
      --coral-primary: #FF6B4A;
      --coral-hover: #E85333;
      --coral-light: #FFF0ED;
      --coral-border: #FFD2C7;

      --mint-primary: #10B981;
      --mint-light: #ECFDF5;
      --mint-border: #A7F3D0;

      --lavender-primary: #8B5CF6;
      --lavender-light: #F5F3FF;
      --lavender-border: #DDD6FE;

      --sun-primary: #F59E0B;
      --sun-light: #FFFBEB;
      --sun-border: #FDE68A;

      --shadow-cute: 0 10px 30px -5px rgba(255, 107, 74, 0.08), 0 4px 12px -2px rgba(0, 0, 0, 0.04);
      --shadow-card: 0 12px 32px rgba(30, 41, 59, 0.04);
      --shadow-float: 0 20px 40px -10px rgba(30, 41, 59, 0.12);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-cream);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      line-height: 1.6;
      scroll-behavior: smooth;
      -webkit-font-smoothing: antialiased;
    }

    /* Sticky Progress Bar */
    .progress-track {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 6px;
      background: var(--coral-light);
      z-index: 100;
    }
    .progress-fill {
      height: 100%;
      width: 0%;
      background: var(--coral-primary);
      border-radius: 0 99px 99px 0;
      transition: width 0.1s ease;
    }

    /* Container */
    .container {
      max-width: 860px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* Cute Floating Header */
    header {
      position: sticky;
      top: 16px;
      z-index: 90;
      margin-bottom: 30px;
    }
    .nav-pill {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(226, 232, 240, 0.8);
      border-radius: 9999px;
      padding: 10px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: var(--shadow-cute);
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .brand-icon {
      width: 36px;
      height: 36px;
      border-radius: 12px;
      background: var(--coral-primary);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }
    .brand-text h4 {
      font-size: 14px;
      font-weight: 800;
      line-height: 1.1;
    }
    .brand-text span {
      font-size: 10px;
      color: var(--text-muted);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .nav-btn {
      background: #0F172A;
      color: white;
      text-decoration: none;
      font-size: 12px;
      font-weight: 700;
      padding: 8px 18px;
      border-radius: 999px;
      transition: all 0.2s ease;
    }
    .nav-btn:hover {
      background: var(--coral-primary);
      transform: translateY(-1px);
    }

    /* Hero */
    .hero {
      text-align: center;
      padding: 30px 0 20px;
    }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-radius: 999px;
      margin-bottom: 16px;
    }
    .badge-coral {
      background: var(--coral-light);
      color: var(--coral-primary);
      border: 1px solid var(--coral-border);
    }
    .badge-mint {
      background: var(--mint-light);
      color: var(--mint-primary);
      border: 1px solid var(--mint-border);
    }
    .badge-sun {
      background: var(--sun-light);
      color: var(--sun-primary);
      border: 1px solid var(--sun-border);
    }

    h1 {
      font-size: clamp(28px, 5vw, 46px);
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -1px;
      color: #0F172A;
      margin-bottom: 16px;
    }
    .text-gradient {
      background: linear-gradient(135deg, var(--coral-primary) 0%, var(--lavender-primary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-subtitle {
      font-size: clamp(15px, 2.5vw, 18px);
      color: var(--text-muted);
      max-width: 620px;
      margin: 0 auto 20px;
      line-height: 1.6;
    }
    .author-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: white;
      padding: 6px 16px;
      border-radius: 999px;
      border: 1px solid #E2E8F0;
      font-size: 12px;
      color: var(--text-muted);
    }
    .avatar {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--coral-primary), var(--lavender-primary));
      color: white;
      font-size: 10px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Cards */
    .card {
      background: var(--card-bg);
      border: 1px solid #E2E8F0;
      border-radius: 24px;
      padding: 28px;
      box-shadow: var(--shadow-card);
      margin-bottom: 28px;
    }
    .card-highlight {
      background: linear-gradient(180deg, #FFFFFF 0%, #FFF8F6 100%);
      border: 1.5px solid var(--coral-border);
      box-shadow: var(--shadow-cute);
    }

    /* Two Buckets Comparison Grid */
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin: 24px 0;
    }
    @media (max-width: 680px) {
      .grid-2 {
        grid-template-columns: 1fr;
      }
    }

    .bucket-card {
      background: white;
      border-radius: 24px;
      padding: 24px;
      border: 2px solid #E2E8F0;
      transition: all 0.2s ease;
    }
    .bucket-card.active-bucket {
      border-color: var(--mint-primary);
      background: linear-gradient(180deg, #FFFFFF 0%, #F0FDF8 100%);
      position: relative;
    }
    .bucket-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }
    .bucket-title {
      font-size: 17px;
      font-weight: 800;
      color: #0F172A;
      margin-bottom: 4px;
    }
    .bucket-subtitle {
      font-size: 11px;
      color: var(--text-muted);
      margin-bottom: 16px;
      display: block;
    }
    .feature-list {
      list-style: none;
      font-size: 12px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      border-top: 1px solid #F1F5F9;
      padding-top: 14px;
    }
    .feature-list li {
      display: flex;
      align-items: flex-start;
      gap: 8px;
    }
    .cross { color: #EF4444; font-weight: bold; }
    .tick { color: var(--mint-primary); font-weight: bold; }

    /* Akbar 1571 Mansabdari 4-Step Cards */
    .mansab-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin: 20px 0;
    }
    @media (max-width: 640px) {
      .mansab-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
    .mansab-step {
      background: #F8FAFC;
      border-radius: 18px;
      padding: 16px 12px;
      text-align: center;
      border: 1px solid #E2E8F0;
    }
    .step-num {
      width: 28px;
      height: 28px;
      background: var(--coral-light);
      color: var(--coral-primary);
      font-weight: 800;
      font-size: 12px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 8px;
    }
    .step-num.danger {
      background: #FEE2E2;
      color: #EF4444;
    }
    .mansab-step h5 {
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .mansab-step p {
      font-size: 11px;
      color: var(--text-muted);
      line-height: 1.3;
    }

    /* 15 Year Roadmap Stepper */
    .stepper {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin: 20px 0;
    }
    .stepper-item {
      display: flex;
      gap: 16px;
      background: white;
      border: 1px solid #E2E8F0;
      border-radius: 20px;
      padding: 18px 20px;
      box-shadow: var(--shadow-card);
      align-items: flex-start;
    }
    .stepper-badge {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      color: white;
      font-weight: 800;
      font-size: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    /* Audit Quiz Section */
    .audit-box {
      background: #0F172A;
      color: white;
      border-radius: 28px;
      padding: 34px 28px;
      box-shadow: var(--shadow-float);
      margin: 30px 0;
    }
    .checklist {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin: 20px 0;
    }
    .check-label {
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 14px 18px;
      border-radius: 16px;
      font-size: 13px;
      color: #E2E8F0;
      cursor: pointer;
      transition: background 0.2s;
    }
    .check-label:hover {
      background: rgba(255, 255, 255, 0.1);
    }
    .check-input {
      width: 18px;
      height: 18px;
      accent-color: var(--coral-primary);
      cursor: pointer;
    }
    .audit-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: gap;
      gap: 14px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding-top: 20px;
      margin-top: 10px;
    }
    .btn-audit {
      background: var(--coral-primary);
      color: white;
      border: none;
      font-family: inherit;
      font-size: 13px;
      font-weight: 800;
      padding: 12px 24px;
      border-radius: 999px;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(255, 107, 74, 0.35);
      transition: all 0.2s;
    }
    .btn-audit:hover {
      background: var(--coral-hover);
      transform: scale(1.02);
    }

    /* Cute FAQs */
    details {
      background: white;
      border: 1px solid #E2E8F0;
      border-radius: 18px;
      padding: 16px 20px;
      margin-bottom: 12px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.02);
    }
    details[open] {
      box-shadow: var(--shadow-cute);
      border-color: var(--coral-border);
    }
    summary {
      font-size: 14px;
      font-weight: 700;
      color: #0F172A;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      list-style: none;
    }
    summary::-webkit-details-marker { display: none; }
    .faq-answer {
      font-size: 13px;
      color: var(--text-muted);
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid #F1F5F9;
      line-height: 1.6;
    }

    /* Neil Patel Style CTA */
    .cta-box {
      background: linear-gradient(135deg, #FFF0ED 0%, #FFFFFF 50%, #FFFBEB 100%);
      border: 2px solid var(--coral-border);
      border-radius: 28px;
      padding: 36px 24px;
      text-align: center;
      margin: 40px 0 60px;
      box-shadow: var(--shadow-cute);
    }
    .reaction-bar {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin: 20px 0;
      flex-wrap: wrap;
    }
    .react-pill {
      background: white;
      border: 1px solid #CBD5E1;
      padding: 8px 16px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      color: var(--text-main);
      cursor: pointer;
      transition: all 0.2s;
    }
    .react-pill:hover {
      border-color: var(--coral-primary);
      transform: translateY(-2px);
    }
    .comment-area {
      max-width: 480px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    textarea {
      width: 100%;
      border: 1px solid #CBD5E1;
      border-radius: 18px;
      padding: 14px;
      font-family: inherit;
      font-size: 13px;
      resize: none;
      outline: none;
    }
    textarea:focus {
      border-color: var(--coral-primary);
      box-shadow: 0 0 0 3px rgba(255, 107, 74, 0.15);
    }
    .btn-comment {
      background: var(--coral-primary);
      color: white;
      border: none;
      font-weight: 800;
      font-size: 13px;
      padding: 12px;
      border-radius: 14px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-comment:hover {
      background: var(--coral-hover);
    }

    footer {
      text-align: center;
      font-size: 12px;
      color: var(--text-muted);
      padding: 30px 0;
      border-top: 1px solid #E2E8F0;
    }
  </style>
</head>

<body>

  <!-- Top Progress Bar -->
  <div class="progress-track">
    <div id="progress-fill" class="progress-fill"></div>
  </div>

  <!-- Cute Nav -->
  <header>
    <div class="container">
      <div class="nav-pill">
        <div class="brand">
          <div class="brand-icon">🎯</div>
          <div class="brand-text">
            <h4>CareerClarity<span style="color:var(--coral-primary)">.io</span></h4>
            <span>Generational Framework</span>
          </div>
        </div>

        <div style="display:flex; align-items:center; gap:10px;">
          <span class="badge badge-mint" style="margin-bottom:0;">
            <span style="width:6px; height:6px; border-radius:50%; background:var(--mint-primary); display:inline-block;"></span> 
            {readingTime}
          </span>
          <a href="#audit-section" class="nav-btn">Run Audit ✨</a>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="container">

    <!-- Hero -->
    <section class="hero">
      <div class="badge badge-coral">✨ Stop Running The Zero-Reset Race</div>
      <h1>
        The Generational Career Trap:<br/>
        <span class="text-gradient">Why Prestigious Jobs Reset You to Zero</span>
      </h1>
      <p class="hero-subtitle">
        Most families spend 40 minutes buying a smartphone, but zero days planning a 40-year generational career. Let's fix that right now.
      </p>

      <div class="author-chip">
        <div class="avatar">NP</div>
        <span>By <strong>Career Architect</strong></span>
        <span>•</span>
        <span>{publishDate}</span>
      </div>
    </section>

    <!-- Highlight Hook Box -->
    <div class="card card-highlight">
      <span class="badge badge-coral">Here is the brutal truth 👇</span>
      <h2 style="font-size:22px; font-weight:800; color:#0F172A; margin:8px 0 12px;">
        Not all prestigious jobs create generational wealth.
      </h2>
      <p style="font-size:14px; color:#334155; line-height:1.7;">
        You will trade <strong>40 years</strong> of your life for a career. If that job automatically strips away your rank, client book, and official authority on the day you turn 60, <strong>your children are forced to start at ground zero</strong>.
      </p>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:16px;">
        <div style="background:white; padding:12px 16px; border-radius:16px; border:1px solid var(--coral-border); font-size:12px;">
          🛑 <strong>Linear Career:</strong> 40 years of service = high status, but <em>zero</em> inheritable equity.
        </div>
        <div style="background:white; padding:12px 16px; border-radius:16px; border:1px solid var(--coral-border); font-size:12px;">
          🚀 <strong>Compounding Path:</strong> 40 years of service = client roster, brand & <em>permanent</em> head start.
        </div>
      </div>
    </div>

    <!-- 1571 Mansabdari System Section -->
    <section style="margin:40px 0;">
      <span class="badge badge-sun">HISTORICAL ORIGIN • 1571 A.D.</span>
      <h2 style="font-size:26px; font-weight:800; margin:6px 0 14px;">
        The 1571 Mansabdari Trap: History's Smartest Illusion 📜
      </h2>
      <p style="font-size:14px; color:#334155; margin-bottom:16px;">
        In 1571, Mughal Emperor Akbar introduced the <strong>Mansabdari System</strong>. On paper, it was the dream job. You commanded 1,000 to 5,000 soldiers, drew a huge salary (~₹3,000/month in historical value), and had royal authority.
      </p>

      <!-- 4-Step Cycle Grid -->
      <div class="card" style="padding:22px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
          <strong style="font-size:13px;">How The Mansabdari Cycle Operated:</strong>
          <span class="badge badge-coral" style="margin:0;">No Inheritance</span>
        </div>

        <div class="mansab-grid">
          <div class="mansab-step">
            <div class="step-num">1</div>
            <h5>Assigned Rank</h5>
            <p>Troops, horses, and tax collection power granted.</p>
          </div>
          <div class="mansab-step">
            <div class="step-num">2</div>
            <h5>Lavish Life</h5>
            <p>Draws huge salary, lives in luxury and status.</p>
          </div>
          <div class="mansab-step">
            <div class="step-num danger">3</div>
            <h5>Retire / Death</h5>
            <p>State seizes back all troops, rank and jagir.</p>
          </div>
          <div class="mansab-step">
            <div class="step-num danger">4</div>
            <h5>Child at Zero</h5>
            <p>Next-gen must restart from the lowest ladder rung.</p>
          </div>
        </div>
      </div>

      <p style="font-size:14px; color:#334155;">
        <strong>The catch?</strong> The Mansab was strictly <em>non-inheritable</em>. The day the Mansabdar died or retired, his 40 years of sweat reverted to the Emperor. His children inherited zero institutional status.
      </p>
    </section>

    <!-- Who are modern mansabdars -->
    <section style="margin:40px 0;">
      <span class="badge badge-coral">PRESENT DAY REALITY</span>
      <h2 style="font-size:26px; font-weight:800; margin:6px 0 14px;">
        Who Are Today's Mansabdars? 🎖️
      </h2>
      <p style="font-size:14px; color:#334155; margin-bottom:16px;">
        Modern civil bureaucracy, administrative officers, and uniformed defense forces (IAS, IPS, CRPF, BSF, State Police).
      </p>

      <div class="card" style="background:#FFF5F2; border-color:var(--coral-border);">
        <h4 style="color:var(--coral-primary); font-size:14px; font-weight:800; margin-bottom:6px;">
          💡 The Day You Turn 60:
        </h4>
        <p style="font-size:13px; color:#475569; margin-bottom:12px;">
          You surrender the official car. You vacate the government bungalow. All that remains is an emotional title: <em>"Retired Additional Chief Secretary"</em> or <em>"Ex-Commandant"</em>.
        </p>
        <div style="background:white; padding:14px; border-radius:16px; border:1px solid #FFD2C7; font-size:12px; color:#1E293B;">
          <strong>And your child?</strong> They cannot inherit one centimeter of that administrative power. If they want to enter that same service, they must sit in the same exam hall with 10 lakh applicants and start at ground zero.
        </div>
      </div>
    </section>

    <!-- Two Buckets Comparison -->
    <section style="margin:50px 0;">
      <div style="text-align:center; margin-bottom:24px;">
        <span class="badge badge-coral">THE STRATEGIC CHOICE</span>
        <h2 style="font-size:28px; font-weight:800;">Which Bucket Are You In?</h2>
        <p style="font-size:13px; color:var(--text-muted);">Both feed your family, but only one gives your kids an unfair advantage.</p>
      </div>

      <div class="grid-2">
        <!-- Bucket A -->
        <div class="bucket-card">
          <div class="bucket-header">
            <span style="font-size:24px;">🏛️</span>
            <span class="badge" style="background:#F1F5F9; color:#475569;">Bucket A</span>
          </div>
          <div class="bucket-title">The Modern Mansabdar</div>
          <span class="bucket-subtitle">Govt Bureaucracy, Defense, Linear Jobs</span>

          <ul class="feature-list">
            <li><span class="cross">✕</span> <span><strong>Asset Transfer:</strong> Zero. Power stays with the chair.</span></li>
            <li><span class="cross">✕</span> <span><strong>10-Year Overlap:</strong> Zero. You can't co-sign files with your kid.</span></li>
            <li><span class="cross">✕</span> <span><strong>Geographic Roots:</strong> Weakened by transfers every 3 years.</span></li>
            <li><span class="tick">✓</span> <span><strong>Day-1 Prestige:</strong> Instant authority and job security.</span></li>
          </ul>
        </div>

        <!-- Bucket B -->
        <div class="bucket-card active-bucket">
          <div class="bucket-header">
            <span style="font-size:24px;">🌱</span>
            <span class="badge badge-mint">Bucket B • Recommended</span>
          </div>
          <div class="bucket-title">The Compounding Architect</div>
          <span class="bucket-subtitle">Law, Medicine/Clinics, CA, Architecture & Design</span>

          <ul class="feature-list">
            <li><span class="tick">✓</span> <span><strong>Asset Transfer:</strong> 100%. Clients, leases & goodwill transfer.</span></li>
            <li><span class="tick">✓</span> <span><strong>10-Year Overlap:</strong> Deep mentorship and smooth handover.</span></li>
            <li><span class="tick">✓</span> <span><strong>Geographic Roots:</strong> Deep multi-decade local commercial influence.</span></li>
