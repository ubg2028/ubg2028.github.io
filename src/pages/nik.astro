  <!-- Single-File Clean Script (No External Dependencies) -->
  <script is:inline>
    // 1. Progress Bar Logic
    window.addEventListener('scroll', function() {
      var winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      var height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      var scrolled = (winScroll / height) * 100;
      var fill = document.getElementById('progress-fill');
      if (fill) fill.style.width = scrolled + '%';
    });

    // 2. Audit Calculator Logic
    document.addEventListener('DOMContentLoaded', function() {
      var auditBtn = document.getElementById('btn-run-audit');
      if (auditBtn) {
        auditBtn.addEventListener('click', function() {
          var checks = document.querySelectorAll('.audit-check:checked');
          var status = document.getElementById('audit-status');
          var count = checks.length;

          if (count === 4) {
            status.textContent = "🚀 100% Compounding Dynasty! Massive generational launchpad.";
            status.style.color = "#34D399";
          } else if (count >= 2) {
            status.textContent = "⚖️ In Transition. Anchor your local network & legal practice!";
            status.style.color = "#FBBF24";
          } else {
            status.textContent = "⚠️ High Mansabdari Risk! High status now, but zero asset transfer.";
            status.style.color = "#FFA894";
          }
        });
      }

      // 3. Reaction Buttons Logic
      var bMansab = document.getElementById('btn-mansab');
      var bArchitect = document.getElementById('btn-architect');
      if (bMansab) {
        bMansab.addEventListener('click', function() {
          var c = document.getElementById('count-mansab');
          c.textContent = parseInt(c.textContent) + 1;
        });
      }
      if (bArchitect) {
        bArchitect.addEventListener('click', function() {
          var c = document.getElementById('count-architect');
          c.textContent = parseInt(c.textContent) + 1;
        });
      }

      // 4. Comment Simulation Logic
      var commentBtn = document.getElementById('btn-submit-comment');
      if (commentBtn) {
        commentBtn.addEventListener('click', function() {
          var txt = document.getElementById('comment-input');
          var alertMsg = document.getElementById('comment-alert');
          if (txt.value.trim() !== "") {
            alertMsg.style.display = "block";
            txt.value = "";
            setTimeout(function() {
              alertMsg.style.display = "none";
            }, 4000);
          }
        });
      }
    });
  </script>

