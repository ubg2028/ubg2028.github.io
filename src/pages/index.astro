---
// ========================================================
// 1. JSON FETCH / IMPORT (Astro Build-Time Fast Fetch)
// ========================================================
import gamesList from '../data/games.json';

const featuredGame = {
  title: "Geometry Neon Dash",
  icon: "🚀",
  badge: "Featured Game",
  iframeUrl: "https://geometrydashlite.io/",
  category: "Arcade • Neon Action"
};
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>KawaiiPlay - Cute & Fun Free Online Games</title>
  <meta name="description" content="Play cute and kawaii online games for free! Arcade, puzzles, and action games in your browser." />
  <meta name="theme-color" content="#0B0F19" />
  <link rel="canonical" href="https://ubg2028.github.io/" />

  <!-- Google Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800;900&display=swap" rel="stylesheet" />

  <!-- Instant Theme Script (Zero White Flash) -->
  <script is:inline>
    const saved = localStorage.getItem('theme');
    if (saved === 'light') {
      document.documentElement.classList.remove('dark');
    } else {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>

<body>
  <!-- ================= SIDEBAR DRAWER ================= -->
  <div id="menuOverlay" class="drawer-overlay hidden" aria-hidden="true"></div>
  
  <aside id="sidebar" class="drawer-sidebar" aria-label="Main Navigation">
    <div class="drawer-content">
      <header class="drawer-header">
        <div class="brand-badge">
          <span>🎀</span>
          <span class="brand-title">CuteGames</span>
        </div>
        <button id="closeMenuBtn" class="btn-icon" aria-label="Close Menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </header>

      <nav class="drawer-nav">
        <a href="/" class="drawer-link active"><span>🔥</span> Home</a>
        <a href="#games-section" class="drawer-link"><span>🎮</span> Arcade & Action</a>
        <a href="#games-section" class="drawer-link"><span>🧩</span> Cute Puzzle</a>
        <a href="#games-section" class="drawer-link"><span>👗</span> Dress Up & Girls</a>
      </nav>
    </div>

    <footer class="drawer-footer">
      <p>© 2026 KawaiiPlay Zone</p>
    </footer>
  </aside>

  <!-- ================= TOP HEADER NAVBAR ================= -->
  <header class="site-header">
    <div class="site-container header-inner">
      <div class="header-left">
        <button id="openMenuBtn" class="btn-icon" aria-label="Open Menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <a href="/" class="site-brand">
          <span class="site-logo">🐱</span>
          <span class="site-name">KawaiiPlay</span>
        </a>
      </div>

      <div class="header-right">
        <button id="themeToggleBtn" class="btn-theme" aria-label="Toggle Dark/Light Theme">
          <svg id="moonIcon" class="icon hidden" width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
          </svg>
          <svg id="sunIcon" class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <span id="themeLabel">Dark</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ================= MAIN CONTENT ================= -->
  <main class="site-container main-wrapper">
    
    <!-- Hero Game Arena -->
    <section class="hero-arena" aria-label="Featured Game Arena">
      <figure id="gameScreenContainer" class="game-viewport">
        <!-- Zero initial bandwidth usage until Play is clicked -->
        <div id="gameCoverOverlay" class="hero-facade" role="button" tabindex="0" aria-label="Play Featured Game">
          <div class="facade-glow-1"></div>
          <div class="facade-glow-2"></div>
          <div class="facade-content">
            <span class="hero-emoji">{featuredGame.icon}</span>
            <span class="pill-badge">{featuredGame.badge}</span>
            <h1 class="hero-heading">{featuredGame.title}</h1>
            <p class="hero-subtext">{featuredGame.category}</p>
            <button id="playGameBtn" class="btn-hero-play">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              PLAY NOW
            </button>
          </div>
        </div>

        <iframe 
          id="gameIframe" 
          class="hero-iframe hidden" 
          data-src={featuredGame.iframeUrl} 
          title={featuredGame.title} 
          allow="fullscreen; autoplay; gamepad" 
          loading="lazy">
        </iframe>
      </figure>

      <div class="hero-controls">
        <button id="fullscreenBtn" class="btn-control">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
          </svg>
          Full Screen
        </button>
      </div>
    </section>

    <!-- More Games Section (Rendered from JSON) -->
    <section id="games-section" class="catalog-section" aria-label="More Games">
      <header class="section-top">
        <div class="section-title-group">
          <span class="section-icon">⭐</span>
          <h2 class="section-heading">More Fun Games</h2>
        </div>
        <span class="badge-counter">{gamesList.length} Games</span>
      </header>

      <!-- Dynamic Grid from JSON data -->
      <div class="catalog-grid">
        {gamesList.map((game) => (
          <article 
            class={`card-item ${game.isFeaturedSpan ? 'span-2x' : ''}`} 
            style={`background: ${game.bg};`}
          >
            {game.badge && <span class="card-tag">{game.badge}</span>}
            
            <div class="card-icon-area">
              <span class="card-emoji">{game.icon}</span>
            </div>

            <!-- Video preview streams only on hover/touch -->
            <video 
              class="card-video-hover" 
              loop 
              muted 
              playsinline 
              preload="none" 
              data-src={game.video}
            ></video>

            <footer class="card-meta">
              <div class="card-info">
                <strong class="card-name">{game.title}</strong>
                {game.category && <small class="card-genre">{game.category}</small>}
              </div>
              <button class="btn-play-sm" aria-label={`Play ${game.title}`}>PLAY</button>
            </footer>
          </article>
        ))}
      </div>

      <div class="explore-action-box">
        <button class="btn-explore-all" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
          <span>🎮</span> Explore All (500+)
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>
    </section>
  </main>

  <!-- ================= FOOTER ================= -->
  <footer class="site-footer">
    <div class="site-container footer-content">
      <div class="partners-block">
        <h3 class="partners-title">OUR PARTNER NETWORKS & BACKLINKS</h3>
        <nav class="partners-nav" aria-label="Partner Links">
          <a href="https://example.com/crazy-games" target="_blank" rel="noopener noreferrer">CrazyGames Portal</a>
          <a href="https://example.com/poki-clone" target="_blank" rel="noopener noreferrer">Poki Free Games</a>
          <a href="https://example.com/html5-arcade" target="_blank" rel="noopener noreferrer">HTML5 Game Hub</a>
          <a href="https://example.com/unblocked-games" target="_blank" rel="noopener noreferrer">Unblocked Games 76</a>
        </nav>
      </div>
      <div class="copyright-block">
        <p>🐱 KawaiiPlay © 2026. Loaded dynamically via JSON.</p>
      </div>
    </div>
  </footer>

  <!-- Floating Scroll To Top -->
  <button id="backToTopBtn" class="btn-floating hidden-float" aria-label="Scroll Back to Top">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <line x1="12" y1="19" x2="12" y2="5"></line>
      <polyline points="5 12 12 5 19 12"></polyline>
    </svg>
    <span>Top</span>
  </button>

  <!-- ================= JAVASCRIPT ================= -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      // 1. Dark/Light Mode Switcher
      const themeBtn = document.getElementById("themeToggleBtn");
      const sunIcon = document.getElementById("sunIcon");
      const moonIcon = document.getElementById("moonIcon");
      const themeLabel = document.getElementById("themeLabel");

      const applyTheme = (isDark) => {
        if (isDark) {
          document.documentElement.classList.add("dark");
          sunIcon?.classList.remove("hidden");
          moonIcon?.classList.add("hidden");
          if (themeLabel) themeLabel.textContent = "Dark";
          localStorage.setItem("theme", "dark");
        } else {
          document.documentElement.classList.remove("dark");
          sunIcon?.classList.add("hidden");
          moonIcon?.classList.remove("hidden");
          if (themeLabel) themeLabel.textContent = "Light";
          localStorage.setItem("theme", "light");
        }
      };

      applyTheme(localStorage.getItem("theme") !== "light");
      themeBtn?.addEventListener("click", () => {
        applyTheme(!document.documentElement.classList.contains("dark"));
      });

      // 2. Mobile Responsive Drawer
      const sidebar = document.getElementById("sidebar");
      const overlay = document.getElementById("menuOverlay");
      const openBtn = document.getElementById("openMenuBtn");
      const closeBtn = document.getElementById("closeMenuBtn");

      const toggleDrawer = (open) => {
        if (open) {
          sidebar?.classList.add("open");
          overlay?.classList.remove("hidden");
          document.body.style.overflow = "hidden";
        } else {
          sidebar?.classList.remove("open");
          overlay?.classList.add("hidden");
          document.body.style.overflow = "";
        }
      };

      openBtn?.addEventListener("click", () => toggleDrawer(true));
      closeBtn?.addEventListener("click", () => toggleDrawer(false));
      overlay?.addEventListener("click", () => toggleDrawer(false));

      // 3. Facade Iframe Launcher
      const cover = document.getElementById("gameCoverOverlay");
      const iframe = document.getElementById("gameIframe");
      const fsBtn = document.getElementById("fullscreenBtn");
      const container = document.getElementById("gameScreenContainer");

      const triggerGame = () => {
        if (iframe && !iframe.src && iframe.dataset.src) {
          iframe.src = iframe.dataset.src;
          iframe.classList.remove("hidden");
          cover?.classList.add("hidden");
        }
      };

      cover?.addEventListener("click", triggerGame);
      fsBtn?.addEventListener("click", () => {
        triggerGame();
        if (!document.fullscreenElement) {
          container?.requestFullscreen().catch(() => {});
        } else {
          document.exitFullscreen();
        }
      });

      // 4. Video Hover / Touch Play
      document.querySelectorAll(".card-item").forEach((card) => {
        const vid = card.querySelector(".card-video-hover");
        if (!vid) return;

        const startVideo = () => {
          if (!vid.src && vid.dataset.src) vid.src = vid.dataset.src;
          vid.play().catch(() => {});
        };

        const stopVideo = () => {
          vid.pause();
          vid.currentTime = 0;
        };

        card.addEventListener("mouseenter", startVideo, { passive: true });
        card.addEventListener("mouseleave", stopVideo, { passive: true });
        card.addEventListener("touchstart", startVideo, { passive: true });
      });

      // 5. Scroll Floating Button
      const floatBtn = document.getElementById("backToTopBtn");
      window.addEventListener("scroll", () => {
        if (window.scrollY > 300) {
          floatBtn?.classList.remove("hidden-float");
        } else {
          floatBtn?.classList.add("hidden-float");
        }
      }, { passive: true });

      floatBtn?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    });
  </script>
</body>
</html>

<!-- ================= CSS3 STYLES ================= -->
<style is:global>
  :root {
    --font-stack: 'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --bg-body: #f4f6fb;
    --bg-surface: #ffffff;
    --bg-surface-elevated: rgba(255, 255, 255, 0.9);
    --border-color: #e2e8f0;
    --text-primary: #0f172a;
    --text-secondary: #64748b;
    --accent-pink: #ec4899;
    --accent-purple: #8b5cf6;
    --accent-gradient: linear-gradient(135deg, #ec4899, #8b5cf6);
    --radius-sm: 8px;
    --radius-md: 14px;
    --radius-lg: 20px;
    --shadow-soft: 0 8px 24px -4px rgba(0, 0, 0, 0.08);
  }

  html.dark {
    --bg-body: #0b0f19;
    --bg-surface: #131b2e;
    --bg-surface-elevated: rgba(11, 15, 25, 0.9);
    --border-color: rgba(255, 255, 255, 0.08);
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --shadow-soft: 0 12px 30px -6px rgba(0, 0, 0, 0.5);
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: var(--font-stack);
    background-color: var(--bg-body);
    color: var(--text-primary);
    line-height: 1.5;
    overflow-x: hidden;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .site-container {
    width: 100%;
    max-width: 1260px;
    margin: 0 auto;
    padding: 0 clamp(12px, 3vw, 24px);
  }

  /* Sticky Top Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: 60px;
    background: var(--bg-surface-elevated);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .site-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .site-logo {
    font-size: 1.4rem;
  }

  .site-name {
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    font-weight: 900;
    color: var(--accent-pink);
    letter-spacing: -0.5px;
  }

  .btn-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .btn-theme {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 800;
    cursor: pointer;
  }

  /* Sidebar Drawer */
  .drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    z-index: 50;
  }

  .drawer-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 280px;
    max-width: 80vw;
    height: 100%;
    background: var(--bg-surface);
    border-right: 1px solid var(--border-color);
    z-index: 60;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
    transform: translateX(-100%);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .drawer-sidebar.open {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .brand-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--accent-pink);
  }

  .drawer-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .drawer-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 800;
    font-size: 0.95rem;
  }

  .drawer-link.active, .drawer-link:hover {
    background: rgba(236, 72, 153, 0.12);
    color: var(--accent-pink);
  }

  .drawer-footer {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* Main & Featured Hero */
  .main-wrapper {
    margin-top: 16px;
  }

  .game-viewport {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 68vh;
    min-height: 220px;
    background: #000;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-soft);
  }

  .hero-facade {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at center, #1e1b4b 0%, #080c16 100%);
    cursor: pointer;
    overflow: hidden;
  }

  .facade-glow-1, .facade-glow-2 {
    position: absolute;
    width: 240px;
    height: 240px;
    background: rgba(236, 72, 153, 0.35);
    filter: blur(80px);
    border-radius: 50%;
  }

  .facade-glow-2 {
    background: rgba(139, 92, 246, 0.25);
    transform: translate(60px, 40px);
  }

  .facade-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 16px;
    gap: 8px;
  }

  .hero-emoji {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
  }

  .pill-badge {
    background: rgba(236, 72, 153, 0.2);
    color: var(--accent-pink);
    border: 1px solid var(--accent-pink);
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .hero-heading {
    font-size: clamp(1.2rem, 4.5vw, 2.2rem);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.2;
  }

  .hero-subtext {
    font-size: 0.85rem;
    color: #94a3b8;
  }

  .btn-hero-play {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--accent-gradient);
    color: #ffffff;
    border: none;
    padding: 10px 26px;
    font-size: 0.95rem;
    font-weight: 900;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(236, 72, 153, 0.45);
    transition: transform 0.15s ease;
  }

  .btn-hero-play:hover {
    transform: scale(1.05);
  }

  .hero-iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .hero-controls {
    display: flex;
    justify-content: flex-end;
    margin-top: 8px;
  }

  .btn-control {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-weight: 800;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  /* Games Catalog Grid */
  .catalog-section {
    margin-top: 32px;
  }

  .section-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .section-title-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .section-heading {
    font-size: clamp(1.1rem, 3vw, 1.35rem);
    font-weight: 900;
  }

  .badge-counter {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    color: var(--accent-pink);
    font-size: 0.75rem;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 999px;
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(135px, 18vw, 185px), 1fr));
    gap: clamp(10px, 2vw, 16px);
  }

  .card-item {
    position: relative;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 8px;
    content-visibility: auto;
    contain-intrinsic-size: 140px;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
  }

  .card-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 22px -4px rgba(0, 0, 0, 0.3);
  }

  @media (min-width: 640px) {
    .card-item.span-2x {
      grid-column: span 2;
      aspect-ratio: 16 / 9;
    }
  }

