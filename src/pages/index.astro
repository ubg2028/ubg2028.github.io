<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>KawaiiPlay - Cute & Fun Free Online Games</title>
  <meta name="description" content="Play the best cute and kawaii online games for free! Arcade, puzzles, dress-up, and action games playable directly in your browser." />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://ubg2028.github.io/" />
  <meta name="theme-color" content="#0B0F19" />

  <!-- Google Font with instant display swap -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800;900&display=swap" rel="stylesheet" />

  <!-- Instant Theme Loader (Zero White Flash) -->
  <script is:inline>
    const theme = localStorage.getItem('theme');
    if (theme === 'light') {
      document.documentElement.classList.remove('dark');
    } else {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>

<body>
  <!-- ================= MOBILE SIDEBAR MENU ================= -->
  <div id="menuOverlay" class="menu-overlay hidden"></div>
  
  <aside id="sidebar" class="sidebar">
    <div class="sidebar-top">
      <div class="sidebar-header">
        <div class="brand">
          <span class="emoji-logo">🎀</span>
          <span class="brand-name">CuteGames</span>
        </div>
        <button id="closeMenuBtn" aria-label="Close Menu" class="icon-btn">
          <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <nav class="sidebar-nav">
        <a href="/" class="nav-item active">🔥 Home</a>
        <a href="#more-games" class="nav-item">🎮 Arcade & Action</a>
        <a href="#more-games" class="nav-item">🧩 Cute Puzzle</a>
        <a href="#more-games" class="nav-item">👗 Dress Up & Girls</a>
      </nav>
    </div>
    <div class="sidebar-footer">
      <p>© 2026 KawaiiPlay Zone</p>
    </div>
  </aside>

  <!-- ================= TOP NAVIGATION NAVBAR ================= -->
  <header class="top-navbar">
    <div class="container nav-content">
      <div class="nav-left">
        <button id="openMenuBtn" aria-label="Open Menu" class="icon-btn">
          <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <a href="/" class="site-logo">
          <span>🐱</span> KawaiiPlay
        </a>
      </div>

      <!-- Theme Switcher -->
      <button id="themeToggleBtn" aria-label="Toggle Theme" class="theme-btn">
        <svg id="moonIcon" class="hidden" width="16" height="16" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
        <svg id="sunIcon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        <span id="themeText">Dark Mode</span>
      </button>
    </div>
  </header>

  <!-- ================= FEATURED GAME HERO ================= -->
  <main class="container main-content">
    <section class="featured-section">
      <div id="gameScreenContainer" class="game-screen-box">
        <div class="aspect-video-box">
          <!-- Click to play cover facade -->
          <div id="gameCoverOverlay" class="hero-cover">
            <div class="hero-glow-blob1"></div>
            <div class="hero-glow-blob2"></div>
            <div class="hero-content">
              <div class="hero-icon-box">🚀</div>
              <span class="badge-featured">Featured Game</span>
              <h1 class="hero-title">Geometry Neon Dash</h1>
              <button id="playGameBtn" class="btn-play-hero">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                PLAY NOW
              </button>
            </div>
          </div>

          <!-- Lazy Iframe (Zero Data usage on slow networks until played) -->
          <iframe 
            id="gameIframe" 
            class="game-iframe hidden" 
            data-src="https://geometrydashlite.io/" 
            title="Featured Game" 
            allow="fullscreen; autoplay; gamepad" 
            loading="lazy">
          </iframe>
        </div>
      </div>

      <!-- Fullscreen Button -->
      <div class="fullscreen-wrapper">
        <button id="fullscreenBtn" class="btn-fullscreen">
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
          Full Screen Mode
        </button>
      </div>
    </section>

    <!-- ================= MORE GAMES SECTION ================= -->
    <section id="more-games" class="games-section">
      <div class="section-header">
        <div class="section-title">
          <span>⭐</span>
          <h2>More Fun Games</h2>
        </div>
        <span class="count-badge">{games.length} Games</span>
      </div>

      <!-- Responsive Dynamic Auto-Fit Grid -->
      <div class="games-grid">
        {games.map((game) => (
          <div class={`game-card ${game.isBig ? 'big-card' : 'small-card'}`} style={`--card-glow: ${game.bg};`}>
            {game.badge && <span class="card-badge">{game.badge}</span>}
            <div class="card-center-icon">{game.icon}</div>
            
            <!-- Video preloads nothing on page load -->
            <video class="hover-video" loop muted playsinline preload="none" data-src={game.video}></video>
            
            <div class={`card-bottom-info ${game.isBig ? '' : 'compact'}`}>
              <div class="card-text-box">
                <span class="card-title">{game.title}</span>
                {game.category && <span class="card-category">{game.category}</span>}
              </div>
              <span class="btn-card-play">PLAY</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Explore More Button -->
      <div class="explore-wrapper">
        <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="btn-explore">
          <span>🎮</span> Explore All Games (500+)
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </button>
      </div>
    </section>
  </main>

  <!-- ================= FOOTER ================= -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-card">
        <h3>OUR PARTNER NETWORKS & BACKLINKS</h3>
        <div class="backlinks">
          <a href="https://example.com/crazy-games" target="_blank" rel="noopener">CrazyGames Portal</a>
          <a href="https://example.com/poki-clone" target="_blank" rel="noopener">Poki Free Games</a>
          <a href="https://example.com/html5-arcade" target="_blank" rel="noopener">HTML5 Game Hub</a>
          <a href="https://example.com/unblocked-games" target="_blank" rel="noopener">Unblocked Games 76</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>🐱 KawaiiPlay © 2026. Fast & Cute Gaming Experience.</span>
      </div>
    </div>
  </footer>

  <!-- ================= FLOATING BACK TO GAME BUTTON ================= -->
  <button id="backToGameBtn" aria-label="Back to Game" class="btn-back-to-game hidden-floating">
    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
    </svg>
    <span>Back to Game</span>
  </button>

  <!-- ================= CLIENT JAVASCRIPT ================= -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      // 1. Dark/Light Mode Switcher
      const themeBtn = document.getElementById("themeToggleBtn");
      const sunIcon = document.getElementById("sunIcon");
      const moonIcon = document.getElementById("moonIcon");
      const themeText = document.getElementById("themeText");

      function updateTheme(isDark) {
        if (isDark) {
          document.documentElement.classList.add("dark");
          sunIcon?.classList.remove("hidden");
          moonIcon?.classList.add("hidden");
          if (themeText) themeText.textContent = "Dark Mode";
          localStorage.setItem("theme", "dark");
        } else {
          document.documentElement.classList.remove("dark");
          sunIcon?.classList.add("hidden");
          moonIcon?.classList.remove("hidden");
          if (themeText) themeText.textContent = "Light Mode";
          localStorage.setItem("theme", "light");
        }
      }

      updateTheme(localStorage.getItem("theme") !== "light");
      themeBtn?.addEventListener("click", () => {
        updateTheme(!document.documentElement.classList.contains("dark"));
      });

      // 2. Mobile Responsive Sidebar Menu
      const sidebar = document.getElementById("sidebar");
      const overlay = document.getElementById("menuOverlay");
      const openBtn = document.getElementById("openMenuBtn");
      const closeBtn = document.getElementById("closeMenuBtn");

      function toggleMenu(show) {
        if (show) {
          sidebar?.classList.add("open");
          overlay?.classList.remove("hidden");
          document.body.style.overflow = "hidden";
        } else {
          sidebar?.classList.remove("open");
          overlay?.classList.add("hidden");
          document.body.style.overflow = "";
        }
      }

      openBtn?.addEventListener("click", () => toggleMenu(true));
      closeBtn?.addEventListener("click", () => toggleMenu(false));
      overlay?.addEventListener("click", () => toggleMenu(false));

      // 3. Iframe On-Demand Loading (Save 5MB on load)
      const cover = document.getElementById("gameCoverOverlay");
      const iframe = document.getElementById("gameIframe");
      const fullscreenBtn = document.getElementById("fullscreenBtn");
      const container = document.getElementById("gameScreenContainer");

      function launchGame() {
        if (iframe && !iframe.src && iframe.dataset.src) {
          iframe.src = iframe.dataset.src;
          iframe.classList.remove("hidden");
          cover?.classList.add("hidden");
        }
      }

      cover?.addEventListener("click", launchGame);

      fullscreenBtn?.addEventListener("click", () => {
        launchGame();
        if (!document.fullscreenElement) {
          container?.requestFullscreen().catch(() => {});
        } else {
          document.exitFullscreen();
        }
      });

      // 4. Video Hover / Touch Play (Lazy network stream)
      document.querySelectorAll(".game-card").forEach((card) => {
        const video = card.querySelector(".hover-video");
        if (!video) return;

        const startVideo = () => {
          if (!video.src && video.dataset.src) video.src = video.dataset.src;
          video.play().catch(() => {});
        };

        const stopVideo = () => {
          video.pause();
          video.currentTime = 0;
        };

        card.addEventListener("mouseenter", startVideo, { passive: true });
        card.addEventListener("mouseleave", stopVideo, { passive: true });
        card.addEventListener("touchstart", startVideo, { passive: true });
      });

      // 5. Back to Top / Game Button
      const backBtn = document.getElementById("backToGameBtn");
      window.addEventListener("scroll", () => {
        if (window.scrollY > 350) {
          backBtn?.classList.remove("hidden-floating");
        } else {
          backBtn?.classList.add("hidden-floating");
        }
      }, { passive: true });

      backBtn?.addEventListener("click", () => {
        if (container) {
          container.scrollIntoView({ behavior: "smooth", block: "center" });
        } else {
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
      });
    });
  </script>
</body>
</html>

<!-- ================= 100% PURE SCOPED CSS (ZERO DEPENDENCY) ================= -->
<style is:global>
  /* --- Colors & Design Tokens --- */
  :root {
    --bg-main: #f8fafc;
    --bg-card: #ffffff;
    --bg-nav: rgba(255, 255, 255, 0.9);
    --border: #e2e8f0;
    --text-main: #0f172a;
    --text-muted: #64748b;
    --primary: #ec4899;
    --primary-gradient: linear-gradient(135deg, #ec4899, #8b5cf6);
    --radius-sm: 8px;
    --radius-md: 14px;
    --radius-lg: 20px;
  }

  html.dark {
    --bg-main: #0b0f19;
    --bg-card: #131b2e;
    --bg-nav: rgba(11, 15, 25, 0.9);
    --border: rgba(255, 255, 255, 0.08);
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
  }

  /* --- Global Reset --- */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Nunito', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: var(--bg-main);
    color: var(--text-main);
    line-height: 1.5;
    overflow-x: hidden;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(10px, 2.5vw, 20px);
  }

  /* --- Top Navbar --- */
  .top-navbar {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: var(--bg-nav);
    border-bottom: 1px solid var(--border);
    height: 56px;
  }

  .nav-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
    font-weight: 900;
    color: var(--primary);
    text-decoration: none;
  }

  .icon-btn, .theme-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-main);
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 700;
  }

  /* --- Sidebar Drawer --- */
  .menu-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    z-index: 50;
  }

  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 270px;
    max-width: 82vw;
    height: 100%;
    background: var(--bg-card);
    border-right: 1px solid var(--border);
    z-index: 60;
    transform: translateX(-100%);
    transition: transform 0.25s ease-out;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px;
  }

  .sidebar.open {
    transform: translateX(0);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .brand {
    font-size: 1.2rem;
    font-weight: 900;
    color: var(--primary);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .nav-item {
    display: block;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .nav-item.active, .nav-item:hover {
    background: rgba(236, 72, 153, 0.12);
    color: var(--primary);
  }

  .sidebar-footer {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* --- Featured Section --- */
  .main-content {
    margin-top: 14px;
  }

  .game-screen-box {
    width: 100%;
    background: #000;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: 0 8px 24px -6px rgba(0,0,0,0.4);
  }

  .aspect-video-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 65vh;
    min-height: 200px;
    background: #07090e;
  }

  .hero-cover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background: radial-gradient(circle at center, #1e1b4b 0%, #0b0f19 100%);
    overflow: hidden;
  }

  .hero-glow-blob1, .hero-glow-blob2 {
    position: absolute;
    width: 220px;
    height: 220px;
    background: rgba(236, 72, 153, 0.35);
    filter: blur(80px);
    border-radius: 50%;
  }

  .hero-glow-blob2 {
    background: rgba(139, 92, 246, 0.25);
    transform: translate(60px, 40px);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 12px;
    gap: 6px;
  }

  .hero-icon-box {
