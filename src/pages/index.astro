---
// ================= 1. JSON DATA IMPORT =================
import gamesData from '../data/games.json';

// Pure CSS Card Themes & Emojis
const cardStyles: Record<number, { bg: string; icon: string }> = {
  1: { bg: 'linear-gradient(135deg, rgba(255,101,132,0.3), rgba(140,122,230,0.2), #0B0F19)', icon: '🐱' },
  2: { bg: 'linear-gradient(135deg, rgba(6,182,212,0.3), rgba(59,130,246,0.2), #0B0F19)', icon: '⚡' },
  3: { bg: 'linear-gradient(135deg, rgba(245,158,11,0.3), rgba(255,101,132,0.2), #0B0F19)', icon: '🍬' },
  4: { bg: 'linear-gradient(135deg, rgba(16,185,129,0.3), rgba(20,184,166,0.2), #0B0F19)', icon: '🎮' },
  5: { bg: 'linear-gradient(135deg, rgba(99,102,241,0.3), rgba(140,122,230,0.2), #0B0F19)', icon: '🔮' },
  6: { bg: 'linear-gradient(135deg, rgba(217,70,239,0.3), rgba(244,63,94,0.2), #0B0F19)', icon: '🏃‍♀️' },
  7: { bg: 'linear-gradient(135deg, rgba(239,68,68,0.3), rgba(249,115,22,0.2), #0B0F19)', icon: '🏎️' },
  8: { bg: 'linear-gradient(135deg, rgba(234,179,8,0.3), rgba(245,158,11,0.2), #0B0F19)', icon: '⭐' },
  9: { bg: 'linear-gradient(135deg, rgba(255,101,132,0.3), rgba(244,63,94,0.2), #0B0F19)', icon: '🧁' },
  10: { bg: 'linear-gradient(135deg, rgba(132,204,22,0.3), rgba(16,185,129,0.2), #0B0F19)', icon: '🦖' },
  11: { bg: 'linear-gradient(135deg, rgba(244,63,94,0.3), rgba(255,101,132,0.2), #0B0F19)', icon: '👗' },
  12: { bg: 'linear-gradient(135deg, rgba(139,92,246,0.3), rgba(99,102,241,0.2), #0B0F19)', icon: '⚔️' },
  13: { bg: 'linear-gradient(135deg, rgba(245,158,11,0.35), rgba(239,68,68,0.25), #0B0F19)', icon: '🦆' },
  14: { bg: 'linear-gradient(135deg, rgba(16,185,129,0.35), rgba(20,184,166,0.25), #0B0F19)', icon: '🍉' },
  15: { bg: 'linear-gradient(135deg, rgba(59,130,246,0.3), rgba(6,182,212,0.2), #0B0F19)', icon: '🤖' },
  16: { bg: 'linear-gradient(135deg, rgba(140,122,230,0.3), rgba(255,101,132,0.2), #0B0F19)', icon: '🫧' },
  17: { bg: 'linear-gradient(135deg, rgba(249,115,22,0.3), rgba(255,101,132,0.2), #0B0F19)', icon: '🍩' },
  18: { bg: 'linear-gradient(135deg, rgba(20,184,166,0.3), rgba(16,185,129,0.2), #0B0F19)', icon: '🧩' },
  19: { bg: 'linear-gradient(135deg, rgba(245,158,11,0.3), rgba(234,179,8,0.2), #0B0F19)', icon: '🐹' },
  20: { bg: 'linear-gradient(135deg, rgba(99,102,241,0.3), rgba(255,101,132,0.2), #0B0F19)', icon: '🌈' },
  21: { bg: 'linear-gradient(135deg, rgba(239,68,68,0.3), rgba(255,101,132,0.2), #0B0F19)', icon: '🐼' },
  22: { bg: 'linear-gradient(135deg, rgba(6,182,212,0.3), rgba(99,102,241,0.2), #0B0F19)', icon: '🪐' },
  23: { bg: 'linear-gradient(135deg, rgba(217,70,239,0.3), rgba(140,122,230,0.2), #0B0F19)', icon: '🦄' },
  24: { bg: 'linear-gradient(135deg, rgba(255,101,132,0.3), rgba(140,122,230,0.2), #0B0F19)', icon: '👾' },
  25: { bg: 'linear-gradient(135deg, rgba(140,122,230,0.3), rgba(59,130,246,0.2), #0B0F19)', icon: '🍮' },
  26: { bg: 'linear-gradient(135deg, rgba(244,63,94,0.3), rgba(245,158,11,0.2), #0B0F19)', icon: '🐾' }
};
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>KawaiiPlay - Cute & Fun Free Online Games</title>
  <meta name="description" content="Play the best cute and kawaii online games for free! Arcade, puzzles, dress-up, and action games playable directly in your browser." />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://ubg2028.github.io/" />
  <meta name="theme-color" content="#0B0F19" />

  <!-- Google Nunito Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Instant Dark Mode Script (No White Flash) -->
  <script is:inline>
    if (localStorage.getItem('theme') === 'light') {
      document.documentElement.classList.remove('dark');
    } else {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>

<body>

  <!-- ================= SIDEBAR MENU ================= -->
  <div id="menuOverlay" class="menu-overlay hidden"></div>

  <aside id="sidebar" class="sidebar">
    <div>
      <div class="sidebar-header">
        <div class="brand">
          <span class="emoji-logo">🎀</span>
          <span class="brand-name">CuteGames</span>
        </div>
        <button id="closeMenuBtn" aria-label="Close Menu" class="icon-btn">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <nav class="sidebar-nav">
        <a href="/" class="nav-item active">🔥 Home</a>
        <a href="#more-games" class="nav-item">🎮 Arcade & Action</a>
        <a href="#more-games" class="nav-item">🧩 Cute Puzzle</a>
        <a href="#more-games" class="nav-item">👗 Dress Up & Girls</a>
      </nav>
    </div>
    <div class="sidebar-footer">
      <p>© 2026 KawaiiPlay Zone</p>
    </div>
  </aside>

  <!-- ================= TOP NAVBAR ================= -->
  <header class="top-navbar">
    <div class="container nav-content">
      <div class="nav-left">
        <button id="openMenuBtn" aria-label="Open Menu" class="icon-btn">
          <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
        <a href="/" class="site-logo">
          <span>🐱</span> KawaiiPlay
        </a>
      </div>

      <!-- Theme Switcher -->
      <button id="themeToggleBtn" aria-label="Toggle Theme" class="theme-btn">
        <svg id="moonIcon" class="hidden" width="18" height="18" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
        <svg id="sunIcon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        <span id="themeText">Dark Mode</span>
      </button>
    </div>
  </header>

  <!-- ================= FEATURED GAME SECTION ================= -->
  <main class="container main-content">
    <section class="featured-section">
      <div id="gameScreenContainer" class="game-screen-box">
        <div class="aspect-video-box">
          
          <!-- PLAY NOW OVERLAY (PURE CSS HERO) -->
          <div id="gameCoverOverlay" class="hero-cover">
            <div class="hero-glow-blob1"></div>
            <div class="hero-glow-blob2"></div>
            
            <div class="hero-content">
              <div class="hero-icon-box">🚀</div>
              <span class="badge-featured">Featured Game</span>
              <h1 class="hero-title">Geometry Neon Dash</h1>
              <button id="playGameBtn" class="btn-play-hero">
                <svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                PLAY NOW
              </button>
            </div>
          </div>

          <!-- IFRAME -->
          <iframe 
            id="gameIframe"
            class="game-iframe hidden"
            data-src="https://geometrydashlite.io/"
            title="Featured Game"
            allow="fullscreen; autoplay; gamepad"
            loading="lazy">
          </iframe>

        </div>
      </div>

      <!-- Fullscreen Button -->
      <div class="fullscreen-wrapper">
        <button id="fullscreenBtn" class="btn-fullscreen">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path></svg>
          Full Screen Mode
        </button>
      </div>
    </section>

    <!-- ================= MORE GAMES SECTION ================= -->
    <section id="more-games" class="games-section">
      <div class="section-header">
        <div class="section-title">
          <span>⭐</span>
          <h2>More Fun Games</h2>
        </div>
        <span class="count-badge">{gamesData.length} Games</span>
      </div>

      <!-- Responsive Dynamic Grid -->
      <div class="games-grid">
        {gamesData.map((game) => {
          const style = cardStyles[game.id] || { bg: 'linear-gradient(135deg, rgba(255,101,132,0.3), rgba(140,122,230,0.2), #0B0F19)', icon: '🎮' };
          
          return game.isBig ? (
            <div class="game-card big-card" style={`background: ${style.bg};`}>
              <span class="card-badge">{game.badge}</span>
              <div class="card-center-icon big-icon">{style.icon}</div>
              <video class="hover-video" loop muted playsinline preload="none" data-src={game.video}></video>
              
              <div class="card-bottom-info">
                <div>
                  <span class="card-title-big">{game.title}</span>
                  <span class="card-category">{game.category}</span>
                </div>
                <span class="btn-card-play">PLAY</span>
              </div>
            </div>
          ) : (
            <div class="game-card small-card" style={`background: ${style.bg};`}>
              <div class="card-center-icon small-icon">{style.icon}</div>
              <video class="hover-video" loop muted playsinline preload="none" data-src={game.video}></video>
              
              <div class="card-bottom-info compact">
                <span class="card-title-small">{game.title}</span>
                <span class="btn-card-play-sm">PLAY</span>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Explore All Games Button -->
      <div class="explore-wrapper">
        <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="btn-explore">
          <span>🎮</span> Explore All Games (500+)
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </button>
      </div>
    </section>
  </main>

  <!-- ================= FOOTER ================= -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-card">
        <h3>OUR PARTNER NETWORKS & BACKLINKS</h3>
        <div class="backlinks">
          <a href="https://example.com/crazy-games" target="_blank" rel="noopener dofollow">CrazyGames Portal</a>
          <a href="https://example.com/poki-clone" target="_blank" rel="noopener dofollow">Poki Free Games</a>
          <a href="https://example.com/html5-arcade" target="_blank" rel="noopener dofollow">HTML5 Game Hub</a>
          <a href="https://example.com/unblocked-games" target="_blank" rel="noopener dofollow">Unblocked Games 76</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>🐱 KawaiiPlay © 2026. Fast & Cute Gaming Experience.</span>
      </div>
    </div>
  </footer>

  <!-- ================= FLOATING BACK TO GAME BUTTON ================= -->
  <button id="backToGameBtn" aria-label="Back to Game" class="btn-back-to-game hidden-floating">
    <svg class="bounce-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
    </svg>
    <span>Back to Game</span>
  </button>

</body>
</html>

<!-- ================= 100% PURE SCOPED CSS (ZERO DEPENDENCY) ================= -->
<style is:global>
  /* Root CSS Variables for Light & Dark Mode */
  :root {
    --bg-color: #f8fafc;
    --text-color: #1e293b;
    --card-bg: #ffffff;
    --border-color: #e2e8f0;
    --pink: #FF6584;
    --hover-pink: #FF4772;
    --purple: #8C7AE6;
    --nav-bg: rgba(255, 255, 255, 0.95);
  }

  html.dark {
    --bg-color: #0B0F19;
    --text-color: #f8fafc;
    --card-bg: #151D30;
    --border-color: #232E4A;
    --nav-bg: rgba(21, 29, 48, 0.95);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Nunito', sans-serif;
    background-color: var(--bg-color);
    color: var(--text-color);
    transition: background-color 0.2s, color 0.2s;
    overflow-x: hidden;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .hidden { display: none !important; }

  /* Navbar */
  .top-navbar {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--nav-bg);
    border-bottom: 1px solid var(--border-color);
    backdrop-filter: blur(8px);
    height: 60px;
    display: flex;
    align-items: center;
  }

  .nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-logo {
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: 900;
    background: linear-gradient(to right, var(--pink), var(--purple));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .icon-btn {
    background: #f1f5f9;
    border: 1px solid var(--border-color);
    color: var(--text-color);
    padding: 0.5rem;
    border-radius: 0.85rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  html.dark .icon-btn { background: #1e293b; color: #cbd5e1; }

  .theme-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    border-radius: 0.85rem;
    background: #f1f5f9;
    border: 1px solid var(--border-color);
    color: var(--text-color);
    font-size: 0.8rem;
    font-weight: 800;
    cursor: pointer;
  }
  html.dark .theme-btn { background: #1e293b; color: #facc15; }

  /* Sidebar */
  .menu-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    z-index: 40;
  }

  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 280px;
    max-width: 80vw;
    height: 100%;
    background: var(--card-bg);
    border-right: 1px solid var(--border-color);
    z-index: 50;
    transform: translateX(-100%);
    transition: transform 0.3s ease-out;
    display: flex;
    flex-col: column;
    justify-content: space-between;
    flex-direction: column;
  }
  .sidebar.open { transform: translateX(0); }

  .sidebar-header {
    padding: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border-color);
  }

  .brand { display: flex; align-items: center; gap: 0.5rem; }
  .emoji-logo { font-size: 1.5rem; }
  .brand-name { font-weight: 900; color: var(--pink); font-size: 1.2rem; }

  .sidebar-nav { padding: 1rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .nav-item {
    text-decoration: none;
    padding: 0.75rem 1rem;
    border-radius: 0.85rem;
    color: var(--text-color);
    font-weight: 700;
    font-size: 0.9rem;
    transition: background 0.2s;
  }
  .nav-item.active { background: rgba(255,101,132,0.12); color: var(--pink); }
  .nav-item:hover { background: rgba(0,0,0,0.05); }
  html.dark .nav-item:hover { background: rgba(255,255,255,0.05); }
  .sidebar-footer { padding: 1rem; text-align: center; border-top: 1px solid var(--border-color); font-size: 0.75rem; opacity: 0.6; }

  /* Featured Game Hero */
  .main-content { padding: 1.5rem 1rem; }
  .featured-section { display: flex; flex-direction: column; align-items: center; }

  .game-screen-box {
    width: 100%;
    max-width: 800px;
    background: #0B0F19;
    border-radius: 1.5rem;
    overflow: hidden;
    border: 3px solid var(--border-color);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    position: relative;
  }

  .aspect-video-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-cover {
    position: absolute;
    inset: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1b1433 0%, #0e1322 50%, #1a0f1d 100%);
    cursor: pointer;
    overflow: hidden;
  }

  .hero-glow-blob1 {
    position: absolute;
    top: -20%;
    left: -10%;
    width: 250px;
    height: 250px;
    background: rgba(255,101,132,0.25);
    border-radius: 50%;
    filter: blur(50px);
  }

  .hero-glow-blob2 {
    position: absolute;
    bottom: -20%;
    right: -10%;
    width: 250px;
    height: 250px;
    background: rgba(140,122,230,0.25);
    border-radius: 50%;
    filter: blur(50px);
  }

  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem;
  }

  .hero-icon-box {
    width: 50px;
    height: 50px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    box-shadow: 0 10px 20px rgba(0,0,0,0.3);
  }

  .badge-featured {
    background: var(--pink);
    color: white;
    font-size: 0.7rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }

  .hero-title {
    color: #ffffff;
    font-size: clamp(1.2rem, 4vw, 2.2rem);
    font-weight: 900;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
  }

  .btn-play-hero {
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.8rem;
    background: linear-gradient(to right, var(--pink), var(--purple));
    color: #ffffff;
    font-weight: 900;
    font-size: 1rem;
    border: none;
    border-radius: 1rem;
    cursor: pointer;
    box-shadow: 0 10px 25px rgba(255,101,132,0.4);
    transition: transform 0.2s;
  }
  .btn-play-hero:hover { transform: scale(1.05); }

  .game-iframe { width: 100%; height: 100%; border: none; }

  .fullscreen-wrapper { margin-top: 0.75rem; }
  .btn-fullscreen {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.2rem;
    background: linear-gradient(to right, var(--purple), var(--pink));
    color: white;
    font-weight: 800;
    font-size: 0.8rem;
    border: none;
    border-radius: 0.85rem;
    cursor: pointer;
  }

  /* Games Grid */
  .games-section { margin-top: 2.5rem; }
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.2rem;
    font-weight: 900;
  }

  .count-badge {
    font-size: 0.75rem;
    font-weight: 800;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }

  .games-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .games-grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  }
  @media (min-width: 1024px) {
    .games-grid { grid-template-columns: repeat(6, 1fr); }
  }

  .game-card {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid var(--border-color);
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
    background-color: #0B0F19;
  }
  .game-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.3);
    border-color: var(--pink);
  }

  .small-card { aspect-ratio: 16 / 11; }
  .big-card {
    grid-column: span 2;
    aspect-ratio: 16 / 9;
  }
  @media (min-width: 640px) { .big-card { grid-column: span 3; } }
  @media (min-width: 1024px) { .big-card { grid-column: span 3; } }

  .card-badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
