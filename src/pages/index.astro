<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>KawaiiPlay - Cute Online Games</title>

  <!-- 100% Instant Dark Mode (No White Flash) -->
  <script is:inline>
    if (localStorage.getItem('theme') === 'light') {
      document.documentElement.classList.remove('dark');
    } else {
      document.documentElement.classList.add('dark');
    }
  </script>

  <!-- Google Nunito Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">

  <style is:global>
    html.dark, html.dark body {
      background-color: #0B0F19 !important;
      color: #F8FAFC !important;
    }
    body {
      font-family: 'Nunito', sans-serif;
    }
    .game-card {
      transform: translateZ(0);
      will-change: transform;
    }
  </style>
</head>
<body class="bg-slate-50 dark:bg-[#0B0F19] text-slate-800 dark:text-slate-100 antialiased selection:bg-[#FF6584] selection:text-white transition-colors duration-200">

  <!-- ================= 2. SLIDE SIDEBAR MENU (NO BLUR) ================= -->
  <div id="menuOverlay" class="fixed inset-0 bg-black/70 z-40 hidden transition-opacity duration-200"></div>

  <aside id="sidebar" class="fixed top-0 left-0 w-72 h-full bg-white dark:bg-[#151D30] z-50 transform -translate-x-full transition-transform duration-300 ease-out shadow-2xl flex flex-col justify-between border-r border-slate-200 dark:border-[#232E4A]">
    <div>
      <div class="p-5 flex items-center justify-between border-b border-slate-100 dark:border-[#232E4A]">
        <div class="flex items-center gap-2">
          <span class="text-3xl">🎀</span>
          <span class="text-xl font-black text-[#FF6584] tracking-wide">CuteGames</span>
        </div>
        <button id="closeMenuBtn" aria-label="Close Menu" class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-red-500">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <nav class="p-4 space-y-2 font-bold text-sm">
        <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-2xl bg-pink-50 dark:bg-pink-950/30 text-[#FF6584]">🔥 Home</a>
        <a href="#more-games" class="flex items-center gap-3 px-4 py-3 rounded-2xl hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">🎮 Arcade & Action</a>
        <a href="#more-games" class="flex items-center gap-3 px-4 py-3 rounded-2xl hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">🧩 Cute Puzzle</a>
        <a href="#more-games" class="flex items-center gap-3 px-4 py-3 rounded-2xl hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">👗 Dress Up & Girls</a>
      </nav>
    </div>
    <div class="p-5 border-t border-slate-100 dark:border-[#232E4A] text-center">
      <p class="text-xs text-slate-400 dark:text-slate-500 font-semibold">© 2026 KawaiiPlay Zone</p>
    </div>
  </aside>

  <!-- ================= 3. TOP NAVBAR ================= -->
  <header class="sticky top-0 z-30 bg-white/95 dark:bg-[#151D30]/95 border-b border-slate-200 dark:border-[#232E4A] shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <button id="openMenuBtn" aria-label="Open Menu" class="p-2 rounded-2xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200/60 dark:border-[#232E4A]">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
        <a href="/" class="flex items-center gap-2 text-2xl font-black bg-gradient-to-r from-[#FF6584] to-[#8C7AE6] bg-clip-text text-transparent">
          <span class="text-2xl">🐱</span> KawaiiPlay
        </a>
      </div>

      <!-- Theme Switcher Button -->
      <button id="themeToggleBtn" aria-label="Toggle Theme" class="flex items-center gap-2 px-3.5 py-2 rounded-2xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-[#232E4A] text-slate-700 dark:text-yellow-400 font-extrabold text-sm active:scale-95 transition-all">
        <svg id="moonIcon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
        <svg id="sunIcon" class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        <span id="themeText" class="hidden sm:inline text-xs">Dark Mode</span>
      </button>
    </div>
  </header>

  <!-- ================= 4. FEATURED GAME IFRAME SECTION ================= -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    <section class="flex flex-col items-center">
      <div id="gameScreenContainer" class="w-full max-w-3xl bg-slate-900 rounded-3xl overflow-hidden shadow-2xl border-4 border-slate-200 dark:border-[#232E4A] ring-4 ring-pink-500/20 relative">
        <div class="relative w-full aspect-video flex items-center justify-center bg-slate-950">
          
          <!-- PLAY NOW OVERLAY -->
          <div id="gameCoverOverlay" class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-slate-900 overflow-hidden cursor-pointer group">
            <img src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=1000&q=80" alt="Featured Game" class="absolute inset-0 w-full h-full object-cover opacity-35 group-hover:scale-105 transition-transform duration-500" />
            <div class="relative z-10 flex flex-col items-center gap-3 p-4 text-center">
              <span class="px-3 py-1 bg-[#FF6584] text-white font-extrabold text-xs uppercase tracking-widest rounded-full shadow-md">Featured Game</span>
              <h2 class="text-2xl sm:text-4xl font-black text-white drop-shadow-md">Geometry Neon Dash</h2>
              <button id="playGameBtn" class="mt-2 flex items-center gap-3 px-8 py-3.5 bg-gradient-to-r from-[#FF6584] to-[#8C7AE6] text-white font-black text-lg rounded-2xl shadow-xl shadow-pink-500/40 transform group-hover:scale-110 active:scale-95 transition-all">
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                PLAY NOW
              </button>
            </div>
          </div>

          <!-- IFRAME -->
          <iframe 
            id="gameIframe"
            class="w-full h-full border-0 hidden"
            data-src="https://geometrydashlite.io/"
            title="Featured Game"
            allow="fullscreen; autoplay; gamepad"
            loading="lazy">
          </iframe>

        </div>
      </div>

      <!-- Fullscreen Button -->
      <div class="mt-3">
        <button id="fullscreenBtn" class="flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-[#8C7AE6] to-[#FF6584] text-white font-extrabold rounded-2xl shadow-md hover:brightness-110 active:scale-95 transition-all text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path></svg>
          Full Screen Mode
        </button>
      </div>
    </section>

    <!-- ================= 5. MORE GAMES SECTION (CUSTOM GRID) ================= -->
    <section id="more-games" class="mt-12">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-2">
          <span class="text-2xl">⭐</span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">More Fun Games</h2>
        </div>
        <span class="text-xs font-extrabold text-slate-500 dark:text-slate-400 bg-slate-200/70 dark:bg-[#151D30] px-3 py-1 rounded-full border border-slate-300/40 dark:border-[#232E4A]">
          {gamesData.length} Handpicked Games
        </span>
      </div>

      <!-- Dynamic Grid: 2 Lines Small + 2 Big Featured + 2 Lines Small -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 sm:gap-4">
        {gamesData.map((game) => (
          game.isBig ? (
            <!-- 2 BADE RECTANGLE CARDS -->
            <div class="game-card group relative col-span-2 sm:col-span-3 md:col-span-3 bg-white dark:bg-[#151D30] rounded-3xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 cursor-pointer aspect-[16/8] sm:aspect-[16/9] border-2 border-pink-400/40 dark:border-[#FF6584]/50">
              <span class="absolute top-3 left-3 z-10 px-3 py-1 bg-[#FF6584] text-white font-black text-xs uppercase tracking-widest rounded-full shadow-lg">{game.badge}</span>
              <img src={game.image} alt={game.title} class="w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-0" loading="lazy" />
              <video class="hover-video absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" loop muted playsinline preload="none" data-src={game.video}></video>
              <div class="absolute bottom-0 inset-x-0 p-4 bg-gradient-to-t from-black/95 via-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-between">
                <div>
                  <span class="text-white font-black text-base sm:text-lg block">{game.title}</span>
                  <span class="text-slate-300 text-xs font-semibold">{game.category}</span>
                </div>
                <span class="bg-gradient-to-r from-[#FF6584] to-[#8C7AE6] text-white text-xs font-black px-4 py-2 rounded-xl shadow-lg">PLAY NOW</span>
              </div>
            </div>
          ) : (
            <!-- CHOTE RECTANGLE CARDS -->
            <div class="game-card group relative bg-white dark:bg-[#151D30] rounded-2xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 cursor-pointer aspect-[16/11] border-2 border-slate-200 dark:border-[#232E4A] hover:border-[#FF6584] dark:hover:border-[#FF6584]">
              <img src={game.image} alt={game.title} class="w-full h-full object-cover transition-opacity duration-200 group-hover:opacity-0" loading="lazy" />
              <video class="hover-video absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none" loop muted playsinline preload="none" data-src={game.video}></video>
              <div class="absolute bottom-0 inset-x-0 p-2.5 bg-gradient-to-t from-black/90 via-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-between">
                <span class="text-white font-extrabold text-xs truncate">{game.title}</span>
                <span class="bg-[#FF6584] text-white text-[9px] font-black px-1.5 py-0.5 rounded-full">PLAY</span>
              </div>
            </div>
          )
        ))}
      </div>

      <!-- Explore All Games Button -->
      <div class="mt-12 text-center">
        <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-[#FF6584] to-[#8C7AE6] text-white text-lg font-black rounded-full shadow-lg hover:shadow-pink-500/50 hover:scale-105 active:scale-95 transition-all">
          <span>🎮</span> Explore All Games (500+)
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </button>
      </div>
    </section>
  </main>

  <!-- ================= 6. FOOTER WITH PARTNER BACKLINKS ================= -->
  <footer class="mt-20 bg-white dark:bg-[#151D30] border-t border-slate-200 dark:border-[#232E4A] pt-10 pb-8 text-slate-600 dark:text-slate-400">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="bg-slate-50 dark:bg-slate-900/60 p-6 rounded-3xl border border-slate-200/80 dark:border-[#232E4A] mb-8">
        <h3 class="text-xs font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-3">Our Partner Networks & Backlinks</h3>
        <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-bold">
          <a href="https://example.com/crazy-games" target="_blank" rel="noopener dofollow" class="hover:text-[#FF6584]">CrazyGames Portal</a>
          <a href="https://example.com/poki-clone" target="_blank" rel="noopener dofollow" class="hover:text-[#FF6584]">Poki Free Games</a>
          <a href="https://example.com/html5-arcade" target="_blank" rel="noopener dofollow" class="hover:text-[#FF6584]">HTML5 Game Hub</a>
          <a href="https://example.com/unblocked-games" target="_blank" rel="noopener dofollow" class="hover:text-[#FF6584]">Unblocked Games 76</a>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-semibold text-slate-400 dark:text-slate-500">
        <span>🐱 KawaiiPlay © 2026. Fast & Cute Gaming Experience.</span>
      </div>
    </div>
  </footer>

  <!-- ================= 7. CLIENT-SIDE SCRIPTS ================= -->
  <script>
    // --- Theme Switcher ---
    const themeBtn = document.getElementById('themeToggleBtn');
    const sunIcon = document.getElementById('sunIcon');
    const moonIcon = document.getElementById('moonIcon');
    const themeText = document.getElementById('themeText');

    function applyTheme(isDark: boolean) {
      if (isDark) {
        document.documentElement.classList.add('dark');
        sunIcon?.classList.remove('hidden');
        moonIcon?.classList.add('hidden');
        if (themeText) themeText.textContent = 'Dark Mode';
        localStorage.setItem('theme', 'dark');
      } else {
        document.documentElement.classList.remove('dark');
        sunIcon?.classList.add('hidden');
        moonIcon?.classList.remove('hidden');
        if (themeText) themeText.textContent = 'Light Mode';
        localStorage.setItem('theme', 'light');
      }
    }

    if (localStorage.getItem('theme') === 'light') applyTheme(false);
    else applyTheme(true);

    themeBtn?.addEventListener('click', () => {
      applyTheme(!document.documentElement.classList.contains('dark'));
    });

    // --- Sidebar Menu ---
    const sidebar = document.getElementById('sidebar');
    const menuOverlay = document.getElementById('menuOverlay');
    document.getElementById('openMenuBtn')?.addEventListener('click', () => {
      menuOverlay?.classList.remove('hidden');
      sidebar?.classList.remove('-translate-x-full');
      document.body.style.overflow = 'hidden';
    });
    const closeMenu = () => {
      sidebar?.classList.add('-translate-x-full');
      menuOverlay?.classList.add('hidden');
      document.body.style.overflow = '';
    };
    document.getElementById('closeMenuBtn')?.addEventListener('click', closeMenu);
    menuOverlay?.addEventListener('click', closeMenu);

    // --- Iframe Play Now & Fullscreen ---
    const cover = document.getElementById('gameCoverOverlay');
    const iframe = document.getElementById('gameIframe') as HTMLIFrameElement;
    const fullscreenBtn = document.getElementById('fullscreenBtn');
    const container = document.getElementById('gameScreenContainer');

    cover?.addEventListener('click', () => {
      if (iframe && !iframe.src && iframe.dataset.src) {
        iframe.src = iframe.dataset.src;
        iframe.classList.remove('hidden');
        cover.classList.add('hidden');
      }
    });

    fullscreenBtn?.addEventListener('click', () => {
      if (iframe && !iframe.src && iframe.dataset.src) {
        iframe.src = iframe.dataset.src;
        iframe.classList.remove('hidden');
        cover?.classList.add('hidden');
      }
      if (!document.fullscreenElement) {
        container?.requestFullscreen();
      } else {
        document.exitFullscreen();
      }
    });

    // --- Smart Video Hover (Loads only on hover) ---
    document.querySelectorAll('.game-card').forEach(card => {
      const video = card.querySelector<HTMLVideoElement>('.hover-video');
      if (!video) return;
      card.addEventListener('mouseenter', () => {
        if (!video.src && video.dataset.src) video.src = video.dataset.src;
        video.play().catch(() => {});
      });
      card.addEventListener('mouseleave', () => {
        video.pause();
        video.currentTime = 0;
      });
    });
  </script>
</body>
</html>