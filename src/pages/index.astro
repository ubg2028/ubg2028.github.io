---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameGrid from '../components/GameGrid.astro';
import RecentlyPlayedRow from '../components/RecentlyPlayedRow.astro';
import FavoritesRow from '../components/FavoritesRow.astro';
import { getAllGames, getFeaturedGame } from '../lib/games.js';

const games = getAllGames();
const featured = getFeaturedGame();

const title = 'The Pizza Edition 690+ Unblocked Games';
const description = 'Play The Pizza Edition 690+ Unblocked Games for free — arcade, puzzle, and action games playable instantly in your browser, no downloads needed.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Pizza Edition',
  url: 'https://ubg2028.github.io/',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://ubg2028.github.io/?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <main class="container main-content">
    <!-- ================= FEATURED GAME SECTION ================= -->
    <section class="featured-section">
      <div id="gameScreenContainer" class="game-screen-box">
        <div class="aspect-video-box">
          <div id="gameCoverOverlay" class="hero-cover">
            <div class="hero-glow-blob1"></div>
            <div class="hero-glow-blob2"></div>

            <div class="hero-content">
              <div class="hero-icon-box">{featured.icon}</div>
              <span class="badge-featured">Featured Game</span>
              <h1 class="hero-title">{featured.title}</h1>
              <button id="playGameBtn" class="btn-play-hero">
                <svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                PLAY NOW
              </button>
            </div>
          </div>

          <iframe
            id="gameIframe"
            class="game-iframe hidden"
            data-src={featured.url}
            title={featured.title}
            allow="fullscreen; autoplay; gamepad"
            loading="lazy">
          </iframe>
        </div>
      </div>

      <!-- Hidden marker so "Continue Playing" can log the featured game too -->
      <div
        data-current-game
        data-slug={featured.slug}
        data-title={featured.title}
        data-thumbnail={featured.thumbnail}
        data-category={featured.category}
        class="hidden"
      ></div>

      <div class="fullscreen-row">
        <button id="fullscreenBtn" class="btn-fullscreen">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path></svg>
          Full Screen Mode
        </button>
        <a href={`/games/${featured.slug}/`} class="btn-fullscreen" style="background: var(--card-bg); color: var(--text-color); border: 1px solid var(--border-color); text-decoration:none;">
          View Game Page →
        </a>
      </div>
    </section>

    <FavoritesRow />
    <RecentlyPlayedRow />

    <!-- ================= MORE GAMES SECTION ================= -->
    <GameGrid games={games} title="More Fun Games" icon="⭐" id="more-games" initialVisible={18} />

    <!-- ================= SEO CONTENT SECTION (Homepage only) ================= -->
    <section class="content-page" style="padding-top:1rem;">
      <article>
        <h2>The Pizza Edition 690+ Unblocked Games</h2>

        <p>If you keep searching for <strong>The Pizza Edition 690+ Unblocked Games</strong> at school or at work, you're not alone. This mega collection puts more than 690 browser titles behind a single, fast-loading link, so switching between racing, shooting, and puzzle games takes seconds, not minutes.</p>

        <p><a href="https://ubg102x.gitlab.io/">Polytrack Unblocked</a> was built for exactly this situation — a network that blocks most gaming sites but still allows simple static pages through. Because <strong>The Pizza Edition Unblocked</strong> loads everything from one lightweight page, it tends to slip past filters that would normally catch a heavier gaming portal.</p>

        <h3>What Makes The Pizza Edition 690+ Unblocked Games Worth Bookmarking</h3>
        <ul>
          <li>Over 690 titles in one place, so the <strong>The Pizza Edition 690+ Unblocked Games</strong> library rarely runs out of something new to try.</li>
          <li><strong>The Pizza Edition Unblocked</strong> loads instantly on school Chromebooks and office laptops alike.</li>
          <li>No downloads or installs — every game in the <strong>The Pizza Edition 690+ Unblocked Games</strong> collection runs straight in the browser.</li>
          <li>A clean, distraction-free layout keeps <strong>The Pizza Edition Unblocked</strong> quick even on slower connections.</li>
        </ul>

        <h3>How to Open The Pizza Edition Unblocked Right Now</h3>
        <p>Getting into <strong>The Pizza Edition 690+ Unblocked Games</strong> takes one click: open the link above, wait a couple of seconds for the game grid to load, then pick a title. Because <strong>The Pizza Edition Unblocked</strong> is a static page, there's nothing to sign up for and nothing to configure — just click and play.</p>

        <h3>FAQs About The Pizza Edition 690+ Unblocked Games</h3>
        <p><strong>Is The Pizza Edition Unblocked really free?</strong> Yes — every game inside <strong>The Pizza Edition 690+ Unblocked Games</strong> is free to play, with no account required.</p>
        <p><strong>Does The Pizza Edition Unblocked work on school Wi-Fi?</strong> In most cases yes, since <strong>The Pizza Edition Unblocked</strong> is hosted as a lightweight static site rather than a heavier game portal.</p>
        <p><strong>How many games are in The Pizza Edition 690+ Unblocked Games?</strong> As the name suggests, the library currently holds more than 690 titles, and <strong>The Pizza Edition Unblocked</strong> keeps adding more over time.</p>

        <p>Bookmark <a href="https://ubg102x.gitlab.io/">Polytrack Unblocked</a> alongside our own game library above, and you'll always have a backup list ready whenever <strong>The Pizza Edition Unblocked</strong> is the site you need.</p>
      </article>
    </section>
  </main>
</BaseLayout>
