---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import GamePlayer from "../../components/GamePlayer.astro";
import GameGrid from "../../components/GameGrid.astro";
import { getAllGames, getGameById, getSeededRandomGames } from "../../lib/gamesApi";

export async function getStaticPaths() {
  const games = await getAllGames();
  return games.map((g) => ({ params: { id: g.id } }));
}

const { id } = Astro.params;
const game = await getGameById(id!);

if (!game) {
  return Astro.redirect("/404");
}

// Seeded on THIS game's own id, so every /game/<id> page gets its own fixed
// selection/order of "more games" — no two game pages look like duplicate
// content to search engines, and the list never changes between visits.
const related = await getSeededRandomGames(`related:${game.id}`, game.id, 12);
const sidebarRelated = await getSeededRandomGames(`sidebar:${game.id}`, game.id, 6);

const pageTitle = `${game.title} Unblocked — Play Free Online`;
const pageDescription = `Play ${game.title} unblocked for free in your browser — no download, no login, works at school and at work. ${game.description}`;

const videoGameSchema = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: game.title,
  url: Astro.site ? new URL(`/game/${game.id}`, Astro.site).toString() : `/game/${game.id}`,
  image: game.thumbnail,
  description: pageDescription,
  genre: game.category,
  applicationCategory: "Game",
  operatingSystem: "Any (Web Browser)",
  playMode: "SinglePlayer",
  ...(game.rating
    ? {
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: game.rating,
          bestRating: 5,
          ratingCount: game.plays ? Math.max(50, Math.round(game.plays / 5000)) : 100,
        },
      }
    : {}),
};
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/game/${game.id}`}
  ogImage={game.thumbnail}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(videoGameSchema)} />
  </Fragment>

  <div class="layout">
    <Sidebar activeCategory={game.category} />
    <main class="main">
      <div class="container">
        <div class="game-detail-layout">
          <div>
            <GamePlayer game={game} />

            <h1 style="margin:16px 0 4px;">{game.title} Unblocked</h1>
            <p class="game-meta">
              {game.category}
              {game.rating ? ` · ★ ${game.rating.toFixed(1)}` : ""}
              {game.plays ? ` · ${game.plays.toLocaleString()} plays` : ""}
            </p>
            <p style="color:var(--text-muted);max-width:70ch;">{game.description}</p>
            {game.instructions && (
              <>
                <h2 class="section-title" style="margin-top:16px;">How to play</h2>
                <p style="color:var(--text-muted);">{game.instructions}</p>
              </>
            )}
          </div>

          <aside>
            <h2 class="section-title" style="margin-top:0;">More Games</h2>
            <div class="related-rail">
              {sidebarRelated.map((g) => (
                <a href={`/game/${g.id}`} class="game-card" style="display:flex;flex-direction:row;gap:10px;align-items:center;">
                  <div class="thumb-wrap" style="width:96px;flex-shrink:0;">
                    <Image src={g.thumbnail} alt={g.title} width={96} height={72} loading="lazy" decoding="async" />
                  </div>
                  <span class="game-title" style="white-space:normal;">{g.title}</span>
                </a>
              ))}
            </div>
          </aside>
        </div>

        <GameGrid title="You might also like" games={related} />
      </div>
    </main>
  </div>
</BaseLayout>
