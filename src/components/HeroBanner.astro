---
import { Image } from "astro:assets";
import type { Game } from "../lib/types";

interface Props { game: Game }
const { game } = Astro.props;
---
<div class="hero-card">
  <Image
    src={game.thumbnail}
    alt={game.title}
    width={1280}
    height={549}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  {game.previewVideo && (
    <video
      class="hero-video"
      muted
      loop
      autoplay
      playsinline
      preload="none"
      data-preview-src={game.previewVideo}
      style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .4s ease"
    ></video>
  )}
  <div class="hero-overlay">
    <h1>{game.title}</h1>
    <p class="game-meta">{game.category}</p>
    <a href={`/game/${game.id}`} class="btn btn-primary" style="width:fit-content;margin-top:8px;">▶ Play Now</a>
  </div>
</div>

<script>
  // Defer the hero video entirely until the browser is idle, so it never
  // competes with the LCP image or main-thread work during initial load.
  const start = () => {
    const video = document.querySelector<HTMLVideoElement>(".hero-video[data-preview-src]");
    if (!video) return;
    const src = video.dataset.previewSrc;
    if (src) video.src = src;
    video.addEventListener("canplay", () => { video.style.opacity = "1"; }, { once: true });
    video.play().catch(() => {});
  };
  if ("requestIdleCallback" in window) {
    (window as any).requestIdleCallback(start, { timeout: 3000 });
  } else {
    setTimeout(start, 1500);
  }
</script>
